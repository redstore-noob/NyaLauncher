<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NyaLauncher.Avalonia.Pages"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="NyaLauncher.Avalonia.Pages.SettingsPage">
  <UserControl.Styles>
    <!-- 卡片通用样式 -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource PanelBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    </Style>
    <!-- 卡片标题 -->
    <Style Selector="TextBlock.card-title">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <!-- 卡片副标题 -->
    <Style Selector="TextBlock.card-subtitle">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}" />
    </Style>
    <!-- 设置项标签 -->
    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>
    <!-- 提示文字 -->
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Java 列表：默认项徽标（accent）与普通项（灰） -->
    <Style Selector="Border.java-badge">
      <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}" />
    </Style>
    <Style Selector="Border.java-badge.default-badge">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.java-badge-fg">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="TextBlock.java-badge-fg.default-fg">
      <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}" />
    </Style>
    <!-- 内嵌卡片（子面板） -->
    <Style Selector="Border.sub-card">
      <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="18,14" />
    </Style>
    <!-- 左侧装饰条 -->
    <Style Selector="Border.accent-bar">
      <Setter Property="Width" Value="5" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="CornerRadius" Value="14,0,0,14" />
    </Style>
    <!-- 卡片标题图标章 -->
    <Style Selector="Border.icon-chip">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource HighlightBgBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="40,40,40,32">

    <!-- 页标题 -->
    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,20">
      <TextBlock Text="设置"
                 FontSize="28"
                 FontWeight="Bold"
                 Foreground="{DynamicResource PrimaryTextBrush}" />
      <TextBlock Text="实例、目录、Java 与下载配置"
                 FontSize="13"
                 Foreground="{DynamicResource HintTextBrush}" />
    </StackPanel>

    <!-- 设置内容 -->
    <ScrollViewer x:Name="SettingsScroller"
                  Grid.Row="1"
                  ScrollChanged="OnSettingsScrollChanged">
      <StackPanel x:Name="CardsStack" Spacing="20">

        <!-- ==================== 游戏设置 ==================== -->
        <Border x:Name="CardGame" Classes="card">
          <Grid>
            <Border Classes="accent-bar" Background="{DynamicResource AccentBrush}" />
            <StackPanel Margin="28,22" Spacing="22">
              <Grid ColumnDefinitions="*,Auto">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Border Classes="icon-chip">
                    <mi:MaterialIcon Kind="Games" Width="19" Height="19" Foreground="{DynamicResource AccentBrush}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="游戏设置" Classes="card-title" />
                    <TextBlock Text="实例行为、游戏目录与内存分配" Classes="card-subtitle" />
                  </StackPanel>
                </Grid>
                <Button Grid.Column="1"
                        Content="实例管理 ▸"
                        Padding="14,7"
                        CornerRadius="8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Background="{DynamicResource ButtonBgBrush}"
                        BorderBrush="{DynamicResource EmphasizedBorderBrush}"
                        BorderThickness="1"
                        Foreground="{DynamicResource LinkTextColorBrush}"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Click="OnOpenInstanceManagerClick" />
              </Grid>

              <Border Classes="sub-card">
                <StackPanel Spacing="8">
                  <CheckBox x:Name="VersionSeparate"
                            Content="版本隔离"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            IsCheckedChanged="OnVersionSeparateChanged" />
                  <TextBlock Text="开启后新实例默认使用独立内容目录（存档、Mod、资源包、光影等各自隔离）"
                             Classes="hint" Margin="26,0,0,0" />
                  <TextBlock x:Name="VersionSeparateHintText"
                             FontSize="11"
                             Foreground="{DynamicResource AccentTextColorBrush}"
                             TextWrapping="Wrap"
                             Margin="26,0,0,0" />
                </StackPanel>
              </Border>

              <Border Classes="sub-card">
                <StackPanel Spacing="4">
                  <CheckBox x:Name="VerifyFilesCheckBox"
                            Content="启动前校验文件完整性"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            IsCheckedChanged="OnVerifyFilesChanged" />
                  <TextBlock Text="每次启动游戏前检查关键文件是否齐全，缺失时自动补全下载"
                             Classes="hint" Margin="26,0,0,0" />
                </StackPanel>
              </Border>

              <StackPanel Spacing="8">
                <TextBlock Text="游戏目录" Classes="field-label" />
                <TextBlock Text="「添加目录」选择 Minecraft 根目录；「设为当前」切换使用的目录；平台默认目录不可删除"
                           Classes="hint" />
                <Grid ColumnDefinitions="*,200" ColumnSpacing="10">
                  <ListBox x:Name="GameDirectoryList"
                           Background="{DynamicResource ControlBgBrush}"
                           BorderThickness="0"
                           CornerRadius="8"
                           Padding="6"
                           MinHeight="120"
                           MaxHeight="190"
                           SelectionChanged="OnGameDirectorySelectionChanged">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="local:GameDirectoryEntry">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="4,3">
                          <Border CornerRadius="5"
                                  Padding="7,2"
                                  VerticalAlignment="Center"
                                  Classes="java-badge"
                                  Classes.default-badge="{Binding BadgeHighlight}">
                            <TextBlock Text="{Binding BadgeText}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Classes="java-badge-fg"
                                       Classes.default-fg="{Binding BadgeHighlight}" />
                          </Border>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding PathText}"
                                     FontSize="11"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center"
                                     ToolTip.Tip="{Binding PathText}" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <Button Content="添加目录"
                            Padding="12,7"
                            CornerRadius="7"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource WhiteBrush}"
                            Cursor="Hand"
                            Click="OnAddGameDirectoryClick" />
                    <Button x:Name="SetCurrentGameDirectoryButton"
                            Content="设为当前"
                            Padding="12,7"
                            CornerRadius="7"
                            FontSize="12"
                            Background="{DynamicResource ButtonBgBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsEnabled="False"
                            Click="OnSetCurrentGameDirectoryClick" />
                    <Button x:Name="RemoveGameDirectoryButton"
                            Content="删除选中"
                            Padding="12,7"
                            CornerRadius="7"
                            FontSize="12"
                            Background="{DynamicResource ButtonBgBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsEnabled="False"
                            Click="OnRemoveGameDirectoryClick" />
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="GameDirectoryHintText" Classes="hint" />
              </StackPanel>

              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="全局最大内存" Classes="field-label" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="MemoryRangeText"
                               Text="系统总内存"
                               FontSize="11"
                               Foreground="{DynamicResource HintTextBrush}"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource BadgeBgBrush}"
                            CornerRadius="6"
                            Padding="10,3">
                      <TextBlock x:Name="MaximumMemoryValueText"
                                 Text="4096 MiB"
                                 FontSize="13"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource AccentTextColorBrush}" />
                    </Border>
                  </StackPanel>
                </Grid>
                <Slider x:Name="MaximumMemorySlider"
                        Minimum="512"
                        Maximum="4096"
                        TickFrequency="256"
                        TickPlacement="BottomRight"
                        IsSnapToTickEnabled="True"
                        ValueChanged="OnMaximumMemoryValueChanged" />
                <CheckBox x:Name="AutomaticMemoryCheckBox"
                          Content="启动时根据可用内存自动调整"
                          FontSize="12"
                          Foreground="{DynamicResource BodyTextBrush}"
                          IsCheckedChanged="OnAutomaticMemoryChanged" />
                <TextBlock x:Name="AutomaticMemoryHintText" Classes="hint" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ==================== Java 设置 ==================== -->
        <Border x:Name="CardJava" Classes="card">
          <Grid>
            <Border Classes="accent-bar" Background="{DynamicResource AccentDarkerBrush}" />
            <StackPanel Margin="28,22" Spacing="22">
              <Grid ColumnDefinitions="*,Auto">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Border Classes="icon-chip">
                    <mi:MaterialIcon Kind="Coffee" Width="19" Height="19" Foreground="{DynamicResource AccentDarkerBrush}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Java 运行环境" Classes="card-title" />
                    <TextBlock Text="Java 路径管理与启动参数" Classes="card-subtitle" />
                  </StackPanel>
                </Grid>
                <Button Grid.Column="1"
                        Content="自动检索全部"
                        Padding="14,7"
                        CornerRadius="8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Background="{DynamicResource ButtonBgBrush}"
                        BorderBrush="{DynamicResource EmphasizedBorderBrush}"
                        BorderThickness="1"
                        Foreground="{DynamicResource LinkTextColorBrush}"
                        Cursor="Hand"
                        Click="OnAutoDetectJavaClick" />
              </Grid>

              <!-- Java 路径列表（ListBox 多路径管理） -->
              <StackPanel Spacing="6">
                <TextBlock Text="已保存的 Java" Classes="field-label" />
                <TextBlock Text="「添加 Java…」选择 javaw.exe；「自动检索全部」会扫描系统并把找到的 Java 全部加入列表。第一条为默认"
                           Classes="hint" />
                <Grid ColumnDefinitions="*,200" ColumnSpacing="10">
                  <ListBox x:Name="JavaList"
                           Background="{DynamicResource ControlBgBrush}"
                           BorderThickness="0"
                           CornerRadius="8"
                           Padding="6"
                           MinHeight="120"
                           MaxHeight="190"
                           SelectionChanged="OnJavaListSelectionChanged">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="local:JavaListEntry">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="4,3">
                          <Border CornerRadius="5"
                                  Padding="7,2"
                                  VerticalAlignment="Center"
                                  Classes="java-badge"
                                  Classes.default-badge="{Binding IsDefault}">
                            <TextBlock Text="{Binding VersionText}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Classes="java-badge-fg"
                                       Classes.default-fg="{Binding IsDefault}" />
                          </Border>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding PathText}"
                                     FontSize="11"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center"
                                     ToolTip.Tip="{Binding PathText}" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <Button Content="添加 Java…"
                            Padding="12,7"
                            CornerRadius="7"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource WhiteBrush}"
                            Cursor="Hand"
                            Click="OnAddJavaPathClick" />
                    <Button x:Name="SetDefaultJavaButton"
                            Content="设为默认"
                            Padding="12,7"
                            CornerRadius="7"
                            FontSize="12"
                            Background="{DynamicResource ButtonBgBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsEnabled="False"
                            Click="OnSetPrimarySelectedJavaClick" />
                    <Button x:Name="RemoveJavaButton"
                            Content="删除选中"
                            Padding="12,7"
                            CornerRadius="7"
                            FontSize="12"
                            Background="{DynamicResource ButtonBgBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsEnabled="False"
                            Click="OnRemoveSelectedJavaClick" />
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="JavaPathHint" Classes="hint" />
              </StackPanel>

              <!-- JVM 启动参数 -->
              <StackPanel Spacing="6">
                <TextBlock Text="额外 JVM 参数" Classes="field-label" />
                <TextBlock Text="每行一个参数，如 -Dfml.ignorePatchDiscrepancies=true"
                           Classes="hint" />
                <TextBox x:Name="JvmArgsBox"
                         PlaceholderText="-XX:+UseG1GC&#x0a;-XX:MaxGCPauseMillis=50"
                         Background="{DynamicResource ControlBgBrush}"
                         BorderThickness="0"
                         CornerRadius="8"
                         Padding="12,8"
                         FontSize="12"
                         AcceptsReturn="True"
                         MinHeight="60"
                         TextWrapping="Wrap" />
              </StackPanel>

              <!-- 保存按钮 -->
              <Button Content="保存 JVM 参数"
                      Padding="18,8"
                      CornerRadius="8"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Background="{DynamicResource AccentBrush}"
                      Foreground="{DynamicResource WhiteBrush}"
                      HorizontalAlignment="Left"
                      Click="OnSaveJavaSettingsClick" />

              <!-- Java 运行时管理入口 -->
              <Border Background="{DynamicResource CardBgBrush}"
                      CornerRadius="10"
                      Padding="16,14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Java 运行时下载" Classes="field-label" />
                    <TextBlock Text="自动下载 Temurin JDK（Java 8 / 17 / 21）到 .minecraft/runtime，启动时自动检测"
                               Classes="hint" />
                    <TextBlock x:Name="JavaRuntimeListText" Classes="hint" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Content="前往下载中心 ›"
                          Padding="16,9"
                          CornerRadius="8"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Background="{DynamicResource AccentBrush}"
                          Foreground="{DynamicResource WhiteBrush}"
                          Cursor="Hand"
                          VerticalAlignment="Center"
                          Click="OnOpenJavaRuntimeManagerClick" />
                </Grid>
              </Border>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ==================== 下载设置 ==================== -->
        <Border x:Name="CardDownload" Classes="card">
          <Grid>
            <Border Classes="accent-bar" Background="{DynamicResource AccentDeepBrush}" />
            <StackPanel Margin="28,22" Spacing="22">
              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Border Classes="icon-chip">
                    <mi:MaterialIcon Kind="CloudDownload" Width="19" Height="19" Foreground="{DynamicResource AccentDeepBrush}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="下载设置" Classes="card-title" />
                    <TextBlock Text="下载源选择与并发下载配置" Classes="card-subtitle" />
                  </StackPanel>
                </Grid>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="下载源" Classes="field-label" />
                <ComboBox x:Name="DownloadSourceComboBox"
                          Background="{DynamicResource ControlBgBrush}"
                          BorderThickness="0"
                          CornerRadius="8"
                          Padding="12,6"
                          HorizontalAlignment="Stretch"
                          FontSize="13"
                          SelectionChanged="OnDownloadSourceChanged" />
                <TextBlock x:Name="DownloadSourceHint" Classes="hint" />
              </StackPanel>

              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="并行下载线程数" Classes="field-label" />
                  <Border Grid.Column="1"
                          Background="{DynamicResource BadgeBgBrush}"
                          CornerRadius="6"
                          Padding="10,3">
                    <TextBlock x:Name="ParallelDownloadsText"
                               Text="8"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentTextColorBrush}" />
                  </Border>
                </Grid>
                <Slider x:Name="ParallelDownloadsSlider"
                        Minimum="1"
                        Maximum="32"
                        TickFrequency="1"
                        TickPlacement="BottomRight"
                        IsSnapToTickEnabled="True"
                        ValueChanged="OnParallelDownloadsChanged" />
                <TextBlock Text="同时下载的文件数量，网络较好时可适当增大" Classes="hint" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ==================== 账户管理入口 ==================== -->
        <Border x:Name="CardAccount" Classes="card">
          <Grid>
            <Border Classes="accent-bar" Background="{DynamicResource SuccessBrush}" />
            <Grid Margin="28,22" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <Border Classes="icon-chip">
                <mi:MaterialIcon Kind="AccountCircle" Width="19" Height="19" Foreground="{DynamicResource SuccessBrush}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="账户管理" Classes="card-title" />
                <TextBlock Text="管理正版与离线账号、切换默认账号并编辑玩家外观" Classes="card-subtitle" />
              </StackPanel>
              <Button Grid.Column="2"
                      Content="打开账户管理"
                      Background="{DynamicResource AccentBrush}"
                      Foreground="{DynamicResource WhiteBrush}"
                      CornerRadius="8"
                      Padding="18,9"
                      FontSize="13"
                      FontWeight="SemiBold"
                      VerticalAlignment="Center"
                      Cursor="Hand"
                      Click="OnOpenAccountManageClick" />
            </Grid>
          </Grid>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
