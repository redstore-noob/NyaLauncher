<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NyaLauncher.Avalonia.Pages.SettingsPage"
             Loaded="Control_OnLoaded">
  <Grid RowDefinitions="Auto,*" Margin="40,40,40,32">

    <!-- 标题区 -->
    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,24">
      <TextBlock Text="设置"
                 FontSize="28"
                 FontWeight="Bold"
                 Foreground="#FFFFFF" />
      <TextBlock Text="自定义启动器与游戏配置"
                 FontSize="13"
                 Foreground="#8B8B9E" />
    </StackPanel>

    <!-- 设置内容 -->
    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="16">

        <!-- 游戏设置 -->
        <Border Background="#1E1E2E"
                CornerRadius="16"
                Padding="24,20">
          <StackPanel Spacing="20">
            <TextBlock Text="游戏设置"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF" />

            <Grid ColumnDefinitions="160,*">
              <TextBlock Text="游戏目录"
                         FontSize="14"
                         Foreground="#CCCCDD"
                         VerticalAlignment="Center" />
              <Border Grid.Column="1" Background="#2A2A3E" CornerRadius="8" Padding="12,8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="C:\Users\Player\.minecraft"
                             FontSize="13"
                             Foreground="#8B8B9E"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="1"
                          Content="浏览"
                          Background="Transparent"
                          Foreground="{StaticResource SystemAccentColor}"
                          FontSize="13"
                          Padding="8,0"
                          Cursor="Hand" />
                </Grid>
              </Border>
            </Grid>

            <Grid ColumnDefinitions="160,*">
              <TextBlock Text="全局最大内存"
                         FontSize="14"
                         Foreground="#CCCCDD"
                         VerticalAlignment="Top"
                         Margin="0,4,0,0" />
              <StackPanel Grid.Column="1" Spacing="9">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="MemoryRangeText"
                             Text="系统总内存"
                             FontSize="12"
                             Foreground="#8B8B9E"
                             VerticalAlignment="Center" />
                  <TextBlock x:Name="MaximumMemoryValueText"
                             Grid.Column="1"
                             Text="4096 MiB"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource SystemAccentColor}" />
                </Grid>
                <Slider x:Name="MaximumMemorySlider"
                        Minimum="512"
                        Maximum="4096"
                        TickFrequency="256"
                        TickPlacement="BottomRight"
                        IsSnapToTickEnabled="True"
                        ValueChanged="OnMaximumMemoryValueChanged" />
                <CheckBox x:Name="AutomaticMemoryCheckBox"
                          Content="启动游戏时根据剩余可用内存自动调整"
                          Foreground="#CCCCDD"
                          IsCheckedChanged="OnAutomaticMemoryChanged" />
                <TextBlock x:Name="AutomaticMemoryHintText"
                           Text="关闭自动调整后，上方滑块作为所有实例都不能突破的全局上限。"
                           FontSize="12"
                           Foreground="#8B8B9E"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Grid>

            <Expander Header="高级选项" IsExpanded="False">
              <StackPanel Spacing="9" Margin="0,8,0,0">
                <TextBlock Text="全局 Java 路径" FontSize="12" Foreground="#8B8B9E" />
                <TextBox x:Name="GlobalJavaExecutableBox"
                         PlaceholderText="留空时自动检测 Java"
                         Background="#2A2A3E"
                         BorderThickness="0"
                         CornerRadius="8" />
                <Grid ColumnDefinitions="*,12,*">
                  <StackPanel>
                    <TextBlock Text="窗口宽度" FontSize="12" Foreground="#8B8B9E" />
                    <TextBox x:Name="GlobalWindowWidthBox" Text="854" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="窗口高度" FontSize="12" Foreground="#8B8B9E" />
                    <TextBox x:Name="GlobalWindowHeightBox" Text="480" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="附加 JVM 参数（每行一个）" FontSize="12" Foreground="#8B8B9E" />
                <TextBox x:Name="GlobalJvmArgumentsBox"
                         AcceptsReturn="True"
                         MinHeight="74"
                         PlaceholderText="例如：-XX:+UseG1GC" />
                <TextBlock Text="附加游戏参数（每行一个）" FontSize="12" Foreground="#8B8B9E" />
                <TextBox x:Name="GlobalGameArgumentsBox"
                         AcceptsReturn="True"
                         MinHeight="74" />
                <Button Content="保存全局高级设置"
                        HorizontalAlignment="Left"
                        Padding="15,7"
                        Background="{StaticResource SystemAccentColor}"
                        Foreground="White"
                        Click="OnSaveGlobalLaunchSettingsClick" />
                <TextBlock x:Name="GlobalLaunchSettingsHintText"
                           Text="实例默认跟随这里的设置。"
                           FontSize="12"
                           Foreground="#8B8B9E"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <!-- 启动器设置 -->
        <Border Background="#1E1E2E"
                CornerRadius="16"
                Padding="24,20">
          <StackPanel Spacing="20">
            <TextBlock Text="启动器设置"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF" />

            <Grid ColumnDefinitions="160,*">
              <TextBlock Text="主题模式"
                         FontSize="14"
                         Foreground="#CCCCDD"
                         VerticalAlignment="Center" />
              <ComboBox Grid.Column="1"
                        PlaceholderText="深色"
                        Background="#2A2A3E"
                        BorderThickness="0"
                        CornerRadius="8"
                        Padding="12,6"
                        HorizontalAlignment="Stretch"
                        FontSize="13">
                <ComboBox.Items>
                  <ComboBoxItem Content="深色" IsSelected="True" />
                  <ComboBoxItem Content="浅色" />
                  <ComboBoxItem Content="跟随系统" />
                </ComboBox.Items>
              </ComboBox>
            </Grid>

            <Grid ColumnDefinitions="160,*">
              <TextBlock Text="语言"
                         FontSize="14"
                         Foreground="#CCCCDD"
                         VerticalAlignment="Center" />
              <ComboBox Grid.Column="1"
                        PlaceholderText="简体中文"
                        Background="#2A2A3E"
                        BorderThickness="0"
                        CornerRadius="8"
                        Padding="12,6"
                        HorizontalAlignment="Stretch"
                        FontSize="13">
                <ComboBox.Items>
                  <ComboBoxItem Content="简体中文" IsSelected="True" />
                  <ComboBoxItem Content="English" />
                  <ComboBoxItem Content="日本語" />
                </ComboBox.Items>
              </ComboBox>
            </Grid>

            <Grid ColumnDefinitions="160,*">
              <TextBlock Text="启动时检查更新"
                         FontSize="14"
                         Foreground="#CCCCDD"
                         VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1"
                            IsChecked="True"
                            HorizontalAlignment="Left" />
            </Grid>

            <Grid ColumnDefinitions="160,*">
              <TextBlock Text="关闭时最小化到托盘"
                         FontSize="14"
                         Foreground="#CCCCDD"
                         VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1"
                            IsChecked="False"
                            HorizontalAlignment="Left" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- 账户管理（入口卡片，完整管理界面已迁移到独立的账户管理页面） -->
        <Border Background="#1E1E2E"
                CornerRadius="16"
                Padding="24,20">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="账户管理"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Foreground="#FFFFFF" />
              <TextBlock Text="管理正版与离线账号、切换默认账号并编辑玩家外观"
                         FontSize="12"
                         Foreground="#8B8B9E" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="打开账户管理"
                    Background="{StaticResource SystemAccentColor}"
                    Foreground="White"
                    CornerRadius="8"
                    Padding="18,9"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    Click="OnOpenAccountManageClick" />
          </Grid>
        </Border>

        <!-- 关于 -->
        <Border Background="#1E1E2E"
                CornerRadius="16"
                Padding="24,20">
          <StackPanel Spacing="12">
            <TextBlock Text="关于"
                      FontSize="18"
                      FontWeight="SemiBold"
                      Foreground="#FFFFFF" />
            <TextBlock Text="NyaLauncher"
                      FontSize="14"
                      x:Name="LauncherText"
                      Foreground="#CCCCDD" />
            <TextBlock
              FontSize="14"
              Foreground="#CCCCDD">除闭源模块,该软件基于Apache-2.0分发。</TextBlock>
            <TextBlock Text="项目链接:https://www.github.com/redstore-noob/NyaLauncher"
                      FontSize="13"
                      x:Name="VersionText"
                      Foreground="#8B8B9E" />
            <HyperlinkButton
              NavigateUri="https://www.github.com/redstore-noob/NyaLauncher"
              Content="为我们的项目点上Star✨">
              
            </HyperlinkButton>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
