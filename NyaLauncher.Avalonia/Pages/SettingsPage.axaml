<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NyaLauncher.Avalonia.Pages.SettingsPage">
  <UserControl.Styles>
    <!-- 卡片通用样式 -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource PanelBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- 卡片标题 -->
    <Style Selector="TextBlock.card-title">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <!-- 卡片副标题 -->
    <Style Selector="TextBlock.card-subtitle">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}" />
    </Style>
    <!-- 设置项标签 -->
    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>
    <!-- 提示文字 -->
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- 内嵌卡片（子面板） -->
    <Style Selector="Border.sub-card">
      <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="18,14" />
    </Style>
    <!-- 左侧装饰条 -->
    <Style Selector="Border.accent-bar">
      <Setter Property="Width" Value="5" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="CornerRadius" Value="14,0,0,14" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="40,40,40,32">

    <!-- 页标题 -->
    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,20">
      <TextBlock Text="设置"
                 FontSize="28"
                 FontWeight="Bold"
                 Foreground="{DynamicResource PrimaryTextBrush}" />
      <TextBlock Text="自定义启动器与游戏配置"
                 FontSize="13"
                 Foreground="{DynamicResource HintTextBrush}" />
    </StackPanel>

    <!-- 设置内容 -->
    <ScrollViewer x:Name="SettingsScroller"
                  Grid.Row="1">
      <StackPanel x:Name="CardsStack" Spacing="20">

        <!-- ==================== 游戏设置 ==================== -->
        <Border x:Name="CardGame" Classes="card">
          <Grid>
            <Border Classes="accent-bar" Background="{DynamicResource AccentBrush}" />
            <StackPanel Margin="28,22" Spacing="22">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="游戏设置" Classes="card-title" />
                  <TextBlock Text="实例行为、游戏目录与内存分配" Classes="card-subtitle" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="实例管理 ▸"
                        Padding="14,7"
                        CornerRadius="8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Background="{DynamicResource ButtonBgBrush}"
                        BorderBrush="{DynamicResource EmphasizedBorderBrush}"
                        BorderThickness="1"
                        Foreground="{DynamicResource LinkTextColor}"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Click="OnOpenInstanceManagerClick" />
              </Grid>

              <Border Classes="sub-card">
                <StackPanel Spacing="8">
                  <CheckBox x:Name="VersionSeparate"
                            Content="版本隔离"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            IsCheckedChanged="OnVersionSeparateChanged" />
                  <TextBlock Text="开启后新实例默认使用独立内容目录（存档、Mod、资源包、光影等各自隔离）"
                             Classes="hint" Margin="26,0,0,0" />
                  <TextBlock x:Name="VersionSeparateHintText"
                             FontSize="11"
                             Foreground="{DynamicResource AccentTextColor}"
                             TextWrapping="Wrap"
                             Margin="26,0,0,0" />
                </StackPanel>
              </Border>

              <Border Classes="sub-card">
                <StackPanel Spacing="4">
                  <CheckBox x:Name="VerifyFilesCheckBox"
                            Content="启动前校验文件完整性"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            IsCheckedChanged="OnVerifyFilesChanged" />
                  <TextBlock Text="每次启动游戏前检查关键文件是否齐全，缺失时自动补全下载"
                             Classes="hint" Margin="26,0,0,0" />
                </StackPanel>
              </Border>

              <StackPanel Spacing="8">
                <TextBlock Text="游戏目录" Classes="field-label" />
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <ComboBox x:Name="GameDirectorySelector"
                            PlaceholderText="选择 Minecraft 游戏目录"
                            Background="{DynamicResource ControlBgBrush}"
                            BorderThickness="0"
                            CornerRadius="8"
                            Padding="12,6"
                            HorizontalAlignment="Stretch"
                            FontSize="13"
                            SelectionChanged="OnGameDirectorySelectionChanged" />
                  <Button Grid.Column="1"
                          Content="＋ 添加"
                          Padding="14,6"
                          CornerRadius="8"
                          FontSize="12"
                          Background="{DynamicResource ButtonBgBrush}"
                          BorderBrush="{DynamicResource EmphasizedBorderBrush}"
                          BorderThickness="1"
                          Click="OnAddGameDirectoryClick" />
                  <Button Grid.Column="2"
                          Content="移除"
                          Padding="14,6"
                          CornerRadius="8"
                          FontSize="12"
                          Click="OnRemoveGameDirectoryClick" />
                </Grid>
                <TextBlock x:Name="GameDirectoryHintText" Classes="hint" />
              </StackPanel>

              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="全局最大内存" Classes="field-label" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="MemoryRangeText"
                               Text="系统总内存"
                               FontSize="11"
                               Foreground="{DynamicResource HintTextBrush}"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource BadgeBgBrush}"
                            CornerRadius="6"
                            Padding="10,3">
                      <TextBlock x:Name="MaximumMemoryValueText"
                                 Text="4096 MiB"
                                 FontSize="13"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource AccentTextColor}" />
                    </Border>
                  </StackPanel>
                </Grid>
                <Slider x:Name="MaximumMemorySlider"
                        Minimum="512"
                        Maximum="4096"
                        TickFrequency="256"
                        TickPlacement="BottomRight"
                        IsSnapToTickEnabled="True"
                        ValueChanged="OnMaximumMemoryValueChanged" />
                <CheckBox x:Name="AutomaticMemoryCheckBox"
                          Content="启动时根据可用内存自动调整"
                          FontSize="12"
                          Foreground="{DynamicResource BodyTextBrush}"
                          IsCheckedChanged="OnAutomaticMemoryChanged" />
                <TextBlock x:Name="AutomaticMemoryHintText" Classes="hint" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ==================== Java 设置 ==================== -->
        <Border x:Name="CardJava" Classes="card">
          <Grid>
            <Border Classes="accent-bar" Background="{DynamicResource AccentDarkerBrush}" />
            <StackPanel Margin="28,22" Spacing="22">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="Java 运行环境" Classes="card-title" />
                  <TextBlock Text="Java 路径管理与启动参数" Classes="card-subtitle" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="自动检索"
                        Padding="14,7"
                        CornerRadius="8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Background="{DynamicResource ButtonBgBrush}"
                        BorderBrush="{DynamicResource EmphasizedBorderBrush}"
                        BorderThickness="1"
                        Foreground="{DynamicResource LinkTextColor}"
                        Cursor="Hand"
                        Click="OnAutoDetectJavaClick" />
              </Grid>

              <!-- Java 路径 -->
              <StackPanel Spacing="6">
                <TextBlock Text="Java 路径" Classes="field-label" />
                <TextBlock Text="留空则自动检测合适的 Java"
                           Classes="hint" />
                <TextBox x:Name="JavaPathBox"
                         PlaceholderText="自动检测"
                         Background="{DynamicResource ControlBgBrush}"
                         BorderThickness="0"
                         CornerRadius="8"
                         Padding="12,8"
                         FontSize="13" />
                <TextBlock x:Name="JavaPathHint" Classes="hint" />
              </StackPanel>

              <!-- JVM 启动参数 -->
              <StackPanel Spacing="6">
                <TextBlock Text="额外 JVM 参数" Classes="field-label" />
                <TextBlock Text="每行一个参数，如 -Dfml.ignorePatchDiscrepancies=true"
                           Classes="hint" />
                <TextBox x:Name="JvmArgsBox"
                         PlaceholderText="-XX:+UseG1GC&#x0a;-XX:MaxGCPauseMillis=50"
                         Background="{DynamicResource ControlBgBrush}"
                         BorderThickness="0"
                         CornerRadius="8"
                         Padding="12,8"
                         FontSize="12"
                         AcceptsReturn="True"
                         MinHeight="60"
                         TextWrapping="Wrap" />
              </StackPanel>

              <!-- 保存按钮 -->
              <Button Content="保存 Java 设置"
                      Padding="18,8"
                      CornerRadius="8"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Background="{DynamicResource SystemAccentColor}"
                      Foreground="{DynamicResource WhiteBrush}"
                      HorizontalAlignment="Left"
                      Click="OnSaveJavaSettingsClick" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- ==================== 下载设置 ==================== -->
        <Border x:Name="CardDownload" Classes="card">
          <Grid>
            <Border Classes="accent-bar" Background="{DynamicResource AccentDeepBrush}" />
            <StackPanel Margin="28,22" Spacing="22">
              <StackPanel Spacing="2">
                <TextBlock Text="下载设置" Classes="card-title" />
                <TextBlock Text="下载源选择与并发下载配置" Classes="card-subtitle" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="下载源" Classes="field-label" />
                <ComboBox x:Name="DownloadSourceComboBox"
                          Background="{DynamicResource ControlBgBrush}"
                          BorderThickness="0"
                          CornerRadius="8"
                          Padding="12,6"
                          HorizontalAlignment="Stretch"
                          FontSize="13"
                          SelectionChanged="OnDownloadSourceChanged" />
                <TextBlock x:Name="DownloadSourceHint" Classes="hint" />
              </StackPanel>

              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="并行下载线程数" Classes="field-label" />
                  <Border Grid.Column="1"
                          Background="{DynamicResource BadgeBgBrush}"
                          CornerRadius="6"
                          Padding="10,3">
                    <TextBlock x:Name="ParallelDownloadsText"
                               Text="8"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentTextColor}" />
                  </Border>
                </Grid>
                <Slider x:Name="ParallelDownloadsSlider"
                        Minimum="1"
                        Maximum="32"
                        TickFrequency="1"
                        TickPlacement="BottomRight"
                        IsSnapToTickEnabled="True"
                        ValueChanged="OnParallelDownloadsChanged" />
                <TextBlock Text="同时下载的文件数量，网络较好时可适当增大" Classes="hint" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ==================== 启动器设置 ==================== -->
        <Border x:Name="CardLauncher" Classes="card">
          <Grid>
            <Border Classes="accent-bar" Background="{DynamicResource MutedTextBrush}" />
            <StackPanel Margin="28,22" Spacing="22">
              <StackPanel Spacing="2">
                <TextBlock Text="启动器设置" Classes="card-title" />
                <TextBlock Text="主题风格与外观配置" Classes="card-subtitle" />
              </StackPanel>

              <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" RowSpacing="12">
                <TextBlock Text="主题风格"
                           FontSize="14"
                           Foreground="{DynamicResource BodyTextBrush}"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="ThemeFamilyComboBox"
                          Grid.Column="1"
                          PlaceholderText="初音未来"
                          Background="{DynamicResource ControlBgBrush}"
                          BorderThickness="0"
                          CornerRadius="8"
                          SelectionChanged="OnThemeFamilyChanged"
                          Padding="12,6"
                          HorizontalAlignment="Stretch"
                          FontSize="13" />
                <TextBlock Text="明暗模式"
                           Grid.Row="1"
                           FontSize="14"
                           Foreground="{DynamicResource BodyTextBrush}"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="ThemeModeComboBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          PlaceholderText="暗色"
                          Background="{DynamicResource ControlBgBrush}"
                          BorderThickness="0"
                          CornerRadius="8"
                          SelectionChanged="OnThemeModeChanged"
                          Padding="12,6"
                          HorizontalAlignment="Stretch"
                          FontSize="13" />
              </Grid>
              <Border Classes="sub-card">
                <TextBlock Text="选择后立即生效，并自动保存。"
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}" />
              </Border>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ==================== 账户管理入口 ==================== -->
        <Border x:Name="CardAccount" Classes="card">
          <Grid>
            <Border Classes="accent-bar" Background="{DynamicResource SuccessBrush}" />
            <Grid Margin="28,22" ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="账户管理" Classes="card-title" />
                <TextBlock Text="管理正版与离线账号、切换默认账号并编辑玩家外观" Classes="card-subtitle" />
              </StackPanel>
              <Button Grid.Column="1"
                      Content="打开账户管理"
                      Background="{DynamicResource SystemAccentColor}"
                      Foreground="{DynamicResource WhiteBrush}"
                      CornerRadius="8"
                      Padding="18,9"
                      FontSize="13"
                      FontWeight="SemiBold"
                      VerticalAlignment="Center"
                      Cursor="Hand"
                      Click="OnOpenAccountManageClick" />
            </Grid>
          </Grid>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
