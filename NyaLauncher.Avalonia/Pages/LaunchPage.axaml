<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NyaLauncher.Avalonia.Pages"
             x:Class="NyaLauncher.Avalonia.Pages.LaunchPage">
  <Grid RowDefinitions="Auto,*,Auto" Margin="40,40,40,32">

    <!-- 标题区 -->
    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,32">
      <TextBlock Text="NyaLauncher"
                 FontSize="36"
                 FontWeight="Bold"
                 Foreground="{StaticResource SystemAccentColor}" />
      <TextBlock Text="一个轻量优雅的 Minecraft 启动器"
                 FontSize="14"
                 Foreground="#8B8B9E" />
    </StackPanel>

    <!-- 中央大启动区 -->
    <Border Grid.Row="1"
            Background="#1E1E2E"
            CornerRadius="16"
            VerticalAlignment="Center"
            HorizontalAlignment="Stretch">
      <Border Padding="32">
        <Grid RowDefinitions="*,Auto,Auto,Auto">
        <!-- 装饰区域 -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="8">
          <Border Width="96" Height="96"
                  CornerRadius="24"
                  Background="#2D2D44"
                  HorizontalAlignment="Center">
            <TextBlock Text="▶"
                       FontSize="40"
                       Foreground="{StaticResource SystemAccentColor}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Minecraft"
                     FontSize="24"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     Foreground="#FFFFFF" />
          <TextBlock Text="Java Edition"
                     FontSize="13"
                     HorizontalAlignment="Center"
                     Foreground="#6B6B80" />
        </StackPanel>

        <!-- Minecraft 目录 -->
        <Border Grid.Row="1"
                Background="#2A2A3E"
                CornerRadius="10"
                Padding="12,8"
                Margin="0,24,0,12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Text="游戏目录"
                       FontSize="12"
                       Foreground="#8B8B9E"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />
            <TextBox x:Name="MinecraftPathBox"
                     Grid.Column="1"
                     Background="Transparent"
                     BorderThickness="0"
                     FontSize="13"
                     PlaceholderText="Minecraft 根目录或 versions\版本号 目录" />
            <Button Grid.Column="2"
                    Content="重新扫描"
                    Padding="12,5"
                    FontSize="12"
                    Click="OnRescanClick" />
          </Grid>
        </Border>

        <!-- 底部控制和启动按钮 -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*,Auto"
              HorizontalAlignment="Stretch"
              Margin="0">

          <!-- 版本选择 -->
          <Border Grid.Column="0" Margin="0,0,8,0"
                  Background="#2A2A3E"
                  CornerRadius="10"
                  Padding="12,6">
            <StackPanel Spacing="4">
              <TextBlock Text="游戏版本"
                         FontSize="11"
                         Foreground="#8B8B9E" />
              <ComboBox x:Name="VersionSelector"
                        PlaceholderText="未找到已安装版本"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14" />
            </StackPanel>
          </Border>

          <!-- 账号选择 -->
          <Border Grid.Column="1" Margin="8,0,0,0"
                  Background="#2A2A3E"
                  CornerRadius="10"
                  Padding="12,6">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="账号"
                           FontSize="11"
                           Foreground="#8B8B9E"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="＋ 新建账户"
                        FontSize="10"
                        Padding="8,2"
                        CornerRadius="6"
                        Click="OnAddAccountClick"
                        Cursor="Hand" />
              </Grid>
              <ComboBox x:Name="AccountSelector"
                        PlaceholderText="未选择账号"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="local:LaunchAccount">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Badge}"
                                 FontSize="10"
                                 Foreground="{StaticResource SystemAccentColor}"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="{Binding DisplayName}"
                                 FontSize="13"
                                 Foreground="#FFFFFF"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Border>

          <!-- 启动按钮 -->
          <Border Grid.Column="2" Margin="16,0,0,0">
            <Button x:Name="LaunchButton"
                    Content="离线启动"
                    Width="160"
                    Height="48"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Background="{StaticResource SystemAccentColor}"
                    Foreground="White"
                    CornerRadius="12"
                    Click="OnLaunchClick"
                    Cursor="Hand">
              <Button.Styles>
                <Style Selector="Button:hover">
                  <Setter Property="Opacity" Value="0.85" />
                </Style>
              </Button.Styles>
            </Button>
          </Border>
        </Grid>
        <TextBlock x:Name="LaunchStatusText"
                   Grid.Row="3"
                   Text="正在查找本地 Minecraft 版本…"
                   FontSize="12"
                   Foreground="#8B8B9E"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Margin="0,18,0,0" />
      </Grid>
      </Border>
    </Border>

    <!-- 新建账户 / 设备码 遮罩（共享控件） -->
    <local:AccountLoginOverlay x:Name="AccountLoginOverlay" Grid.RowSpan="3" />

    <!-- 底部信息 -->
    <TextBlock Grid.Row="2"
               Text="NyaLauncher v0.1.0-gp2 · 使用 Avalonia 构建"
               FontSize="12"
               Foreground="#5A5A70"
               HorizontalAlignment="Center"
               Margin="0,24,0,0" />
  </Grid>
</UserControl>
