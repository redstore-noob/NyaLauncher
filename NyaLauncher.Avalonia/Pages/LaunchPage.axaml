<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NyaLauncher.Avalonia.Pages.LaunchPage">
  <Grid RowDefinitions="Auto,*,Auto" Margin="40,40,40,32">

    <!-- 标题区 -->
    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,32">
      <TextBlock Text="NyaLauncher"
                 FontSize="36"
                 FontWeight="Bold"
                 Foreground="{StaticResource SystemAccentColor}" />
      <TextBlock Text="一个轻量优雅的 Minecraft 启动器"
                 FontSize="14"
                 Foreground="#8B8B9E" />
    </StackPanel>

    <!-- 中央大启动区 -->
    <Border Grid.Row="1"
            Background="#1E1E2E"
            CornerRadius="16"
            VerticalAlignment="Center"
            HorizontalAlignment="Stretch">
      <Border Padding="32">
        <Grid RowDefinitions="*,Auto,Auto,Auto">
        <!-- 装饰区域 -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="8">
          <Border Width="96" Height="96"
                  CornerRadius="24"
                  Background="#2D2D44"
                  HorizontalAlignment="Center">
            <TextBlock Text="▶"
                       FontSize="40"
                       Foreground="{StaticResource SystemAccentColor}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Minecraft"
                     FontSize="24"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     Foreground="#FFFFFF" />
          <TextBlock Text="Java Edition"
                     FontSize="13"
                     HorizontalAlignment="Center"
                     Foreground="#6B6B80" />
        </StackPanel>

        <!-- Minecraft 目录 -->
        <Border Grid.Row="1"
                Background="#2A2A3E"
                CornerRadius="10"
                Padding="12,8"
                Margin="0,24,0,12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Text="游戏目录"
                       FontSize="12"
                       Foreground="#8B8B9E"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />
            <TextBox x:Name="MinecraftPathBox"
                     Grid.Column="1"
                     Background="Transparent"
                     BorderThickness="0"
                     FontSize="13"
                     PlaceholderText="Minecraft 根目录或 versions\版本号 目录" />
            <Button Grid.Column="2"
                    Content="重新扫描"
                    Padding="12,5"
                    FontSize="12"
                    Click="OnRescanClick" />
          </Grid>
        </Border>

        <!-- 底部控制和启动按钮 -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*,Auto"
              HorizontalAlignment="Stretch"
              Margin="0">

          <!-- 版本选择 -->
          <Border Grid.Column="0" Margin="0,0,8,0"
                  Background="#2A2A3E"
                  CornerRadius="10"
                  Padding="12,6">
            <StackPanel Spacing="4">
              <TextBlock Text="游戏版本"
                         FontSize="11"
                         Foreground="#8B8B9E" />
              <ComboBox x:Name="VersionSelector"
                        PlaceholderText="未找到已安装版本"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14" />
            </StackPanel>
          </Border>

          <!-- 账号选择 -->
          <Border Grid.Column="1" Margin="8,0,0,0"
                  Background="#2A2A3E"
                  CornerRadius="10"
                  Padding="12,6">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="AccountLabel"
                           Text="离线用户名"
                           FontSize="11"
                           Foreground="#8B8B9E"
                           VerticalAlignment="Center" />
                <Button x:Name="MicrosoftLoginButton"
                        Grid.Column="1"
                        Content="微软登录"
                        FontSize="10"
                        Padding="8,2"
                        CornerRadius="6"
                        Click="OnMicrosoftLoginClick"
                        Cursor="Hand" />
              </Grid>
              <TextBox x:Name="OfflineUsernameBox"
                       Text="Player_01"
                       MaxLength="16"
                       Background="Transparent"
                       BorderThickness="0"
                       FontSize="14" />
              <!-- 正版账号信息（登录后显示） -->
              <Border x:Name="MicrosoftAccountPanel"
                      IsVisible="False"
                      Background="#1E1E2E"
                      CornerRadius="8"
                      Padding="8,4"
                      Margin="0,4,0,0">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock x:Name="MicrosoftAccountName"
                               FontSize="13"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MicrosoftAccountState"
                               FontSize="10"
                               Foreground="#8B8B9E" />
                  </StackPanel>
                  <Button x:Name="MicrosoftRefreshButton"
                          Grid.Column="1"
                          Content="刷新"
                          FontSize="10"
                          Padding="8,2"
                          Margin="0,0,4,0"
                          CornerRadius="6"
                          Click="OnMicrosoftRefreshClick"
                          Cursor="Hand" />
                  <Button x:Name="MicrosoftLogoutButton"
                          Grid.Column="2"
                          Content="退出"
                          FontSize="10"
                          Padding="8,2"
                          CornerRadius="6"
                          Click="OnMicrosoftLogoutClick"
                          Cursor="Hand" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <!-- 启动按钮 -->
          <Border Grid.Column="2" Margin="16,0,0,0">
            <Button x:Name="LaunchButton"
                    Content="离线启动"
                    Width="160"
                    Height="48"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Background="{StaticResource SystemAccentColor}"
                    Foreground="White"
                    CornerRadius="12"
                    Click="OnLaunchClick"
                    Cursor="Hand">
              <Button.Styles>
                <Style Selector="Button:hover">
                  <Setter Property="Opacity" Value="0.85" />
                </Style>
              </Button.Styles>
            </Button>
          </Border>
        </Grid>
        <TextBlock x:Name="LaunchStatusText"
                   Grid.Row="3"
                   Text="正在查找本地 Minecraft 版本…"
                   FontSize="12"
                   Foreground="#8B8B9E"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Margin="0,18,0,0" />
      </Grid>
      </Border>
    </Border>

    <!-- 设备码验证覆盖层 -->
    <Panel x:Name="DeviceCodeOverlay"
           Grid.RowSpan="3"
           IsVisible="False"
           Background="#C0000000">
      <Border Background="#1E1E2E"
              CornerRadius="16"
              Padding="36,28"
              MaxWidth="440"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Text="微软账号登录"
                     FontSize="20"
                     FontWeight="Bold"
                     Foreground="#FFFFFF"
                     HorizontalAlignment="Center" />
          <TextBlock x:Name="DeviceCodeHintText"
                     Text="请在浏览器中打开以下地址，然后输入验证码"
                     FontSize="12"
                     Foreground="#8B8B9E"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Center" />
          <Border Background="#2D2D44"
                  CornerRadius="10"
                  Padding="28,12"
                  HorizontalAlignment="Center">
            <TextBlock x:Name="DeviceCodeText"
                       FontSize="30"
                       FontWeight="Bold"
                       LetterSpacing="8"
                       Foreground="{StaticResource SystemAccentColor}" />
          </Border>
          <TextBlock x:Name="DeviceCodeUrlText"
                     FontSize="12"
                     Foreground="#6B6B80"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Center" />
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      Spacing="10">
            <Button x:Name="DeviceCodeOpenBrowserButton"
                    Content="打开浏览器"
                    Padding="14,7"
                    CornerRadius="8"
                    Click="OnDeviceCodeOpenBrowserClick"
                    Cursor="Hand" />
            <Button x:Name="DeviceCodeCancelButton"
                    Content="取消登录"
                    Padding="14,7"
                    CornerRadius="8"
                    Click="OnDeviceCodeCancelClick"
                    Cursor="Hand" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>

    <!-- 底部信息 -->
    <TextBlock Grid.Row="2"
               Text="NyaLauncher v1.0.0 · 使用 Avalonia 构建"
               FontSize="12"
               Foreground="#5A5A70"
               HorizontalAlignment="Center"
               Margin="0,24,0,0" />
  </Grid>
</UserControl>
