<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NyaLauncher.Avalonia.Pages.AboutPage"
             Loaded="Control_OnLoaded">
  <Grid x:Name="RootGrid">
  <ScrollViewer>
    <StackPanel Spacing="16" Margin="32,28">

      <!-- 标题 -->
      <StackPanel Spacing="8" Margin="0,0,0,8">
        <TextBlock Text="关于"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryTextBrush}" />
        <TextBlock Text="NyaLauncher 开发团队、第三方组件与项目信息"
                   FontSize="13"
                   Foreground="{DynamicResource HintTextBrush}" />
      </StackPanel>

      <!-- 开发者名单保持静态，名字在悬停时也可点击。
           除 TouristH 外，连点卡片 7 次仍触发「猫娘登场」彩蛋。 -->
      <Border Background="{DynamicResource PanelBgBrush}"
              CornerRadius="16"
              Padding="24,20"
              PointerPressed="DevCard_OnPointerPressed">
        <StackPanel Spacing="20">
          <StackPanel Spacing="12">
            <TextBlock Text="开发者名单"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <StackPanel>
              <TextBlock Text="redstore_noob" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource BodyTextBrush}" />
              <TextBlock x:Name="TouristHName" Text="TouristH"
                         HorizontalAlignment="Left"
                         FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource BodyTextBrush}" />
              <TextBlock Text="ReGlaze" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource BodyTextBrush}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="10">
            <TextBlock Text="喵～感谢每一位使用者"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock FontSize="13"
                       Foreground="{DynamicResource HintTextBrush}"
                       TextWrapping="Wrap">
              如果喜欢这个启动器，去 GitHub 给项目点个 Star 就是最大的支持啦～
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 引用的库与资源 -->
      <Border Background="{DynamicResource PanelBgBrush}"
              CornerRadius="16"
              Padding="24,20"
              Classes="nya-lift nya-shimmer">
        <StackPanel Spacing="12">
          <TextBlock Text="引用的库与资源"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
          <Grid ColumnDefinitions="160,*"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                ColumnSpacing="8"
                RowSpacing="10">
            <TextBlock Text="Avalonia UI"
                       Grid.Row="0" FontSize="13"
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="13"
                       Foreground="{DynamicResource BodyTextBrush}"
                       VerticalAlignment="Center">
              12.1.1 · 跨平台 UI 框架（MIT License）
              https://github.com/AvaloniaUI/Avalonia
            </TextBlock>

            <TextBlock Text="Material.Avalonia"
                       Grid.Row="1" FontSize="13"
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="13"
                       Foreground="{DynamicResource BodyTextBrush}"
                       VerticalAlignment="Center">
              3.19.0 · Material Design 风格与控件库（MIT License）
              https://github.com/AvaloniaCommunity/Material.Avalonia
            </TextBlock>

            <TextBlock Text="Material.Icons.Avalonia"
                       Grid.Row="2" FontSize="13"
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="13"
                       Foreground="{DynamicResource BodyTextBrush}"
                       VerticalAlignment="Center">
              3.0.2 · Material Design 图标库（MIT License）
              https://github.com/SKProCH/Material.Icons
            </TextBlock>

            <TextBlock Text="CommunityToolkit.Mvvm"
                       Grid.Row="3" FontSize="13"
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Grid.Column="1" FontSize="13"
                       Foreground="{DynamicResource BodyTextBrush}"
                       VerticalAlignment="Center">
              8.4.2 · 现代化 MVVM 工具包（MIT License）
              https://github.com/CommunityToolkit/dotnet
            </TextBlock>

            <TextBlock Text="NAudio"
                       Grid.Row="4" FontSize="13"
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Row="4" Grid.Column="1" FontSize="13"
                       Foreground="{DynamicResource BodyTextBrush}"
                       VerticalAlignment="Center">
              2.2.1 · 音乐播放器音频后端（MS-PL License）
              https://github.com/naudio/NAudio
            </TextBlock>

            <TextBlock Text="OpenAI .NET"
                       Grid.Row="5" FontSize="13"
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Row="5" Grid.Column="1" FontSize="13"
                       Foreground="{DynamicResource BodyTextBrush}"
                       VerticalAlignment="Center">
              2.13.0 · AI 对话接口调用（OpenAI 官方 SDK · Apache-2.0）
              https://github.com/openai/openai-dotnet
            </TextBlock>

            <TextBlock Text="BMCLAPI"
                       Grid.Row="6" FontSize="13"
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Row="6" Grid.Column="1" FontSize="13"
                       Foreground="{DynamicResource BodyTextBrush}"
                       VerticalAlignment="Center">
              Minecraft 下载镜像服务（bangbang93）
              https://bmclapi2.bangbang93.com
            </TextBlock>
          </Grid>
        </StackPanel>
      </Border>

      <!-- 项目信息 -->
      <Border Background="{DynamicResource PanelBgBrush}"
              CornerRadius="16"
              Padding="24,20"
              Classes="nya-lift nya-shimmer">
        <StackPanel Spacing="12">
          <TextBlock Text="项目信息"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
          <TextBlock Text="NyaLauncher"
                     FontSize="14"
                     x:Name="LauncherText"
                     Foreground="{DynamicResource BodyTextBrush}" />
          <TextBlock x:Name="EasterEggHint"
                     IsVisible="False"
                     FontSize="11"
                     Foreground="{DynamicResource HintTextBrush}"
                     Margin="0,4,0,0" />
          <TextBlock FontSize="14"
                     x:Name="LatestDate"
                     Foreground="{DynamicResource BodyTextBrush}">
            最后补丁日期:
          </TextBlock>
          <TextBlock FontSize="14"
                     Foreground="{DynamicResource BodyTextBrush}"
                     TextWrapping="Wrap">
            除闭源模块外，该软件基于 Apache License 2.0 分发。
          </TextBlock>
          <TextBlock FontSize="14"
                     Foreground="{DynamicResource BodyTextBrush}">
              该软件为NyaLauncher team编写，与Mojang Studios与Microsoft没有直接联系。
          </TextBlock>
          <TextBlock Text="https://github.com/redstore-noob/NyaLauncher"
                     FontSize="13"
                     x:Name="VersionText"
                     Foreground="{DynamicResource HintTextBrush}"
                     Classes="nya-marquee" />
          <HyperlinkButton NavigateUri="https://github.com/redstore-noob/NyaLauncher"
                           Content="项目链接喵~Ciallo～(∠・ω&lt; )⌒★" />
        </StackPanel>
      </Border>

      <!-- QQ 群 -->
      <Border Background="{DynamicResource PanelBgBrush}"
              CornerRadius="16"
              Padding="24,20"
              Classes="nya-lift nya-shimmer">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="加入我们"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock FontSize="14"
                       Text="QQ 群：1108330006 · 反馈建议 · 版本抢先体验 · 日常摸鱼"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource BodyTextBrush}" />
          </StackPanel>
          <Button Grid.Column="1"
                  VerticalAlignment="Center"
                  Click="OnCopyGroupClick"
                  Content="复制群号" />
        </Grid>
      </Border>

    </StackPanel>
  </ScrollViewer>

  <!-- 猫娘彩蛋覆盖层：连点开发者卡片 7 次触发；点击任意处关闭 -->
  <Border x:Name="NekoOverlay"
          IsVisible="False"
          Background="#AA000000"
          PointerPressed="NekoOverlay_OnPointerPressed">
    <Border x:Name="NekoCard"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            CornerRadius="20"
            Padding="18"
            Background="{DynamicResource PanelBgBrush}"
            BorderBrush="{DynamicResource DefaultBorderBrush}"
            BorderThickness="1">
      <StackPanel Spacing="10">
        <Image Source="avares://NyaLauncher.Avalonia/Resources/Images/neko-girl.png"
               MaxHeight="500"
               Stretch="Uniform" />
        <TextBlock Text="奈娅(Nya)美图🥰"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   HorizontalAlignment="Center" />
        
        <TextBlock Text="点击任意处关闭"
                   FontSize="11"
                   Foreground="{DynamicResource HintTextBrush}"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Border>
  </Grid>
</UserControl>
