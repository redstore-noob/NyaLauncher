<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:NyaLauncher.Core.Models"
             xmlns:download="using:NyaLauncher.Core.Download"
             xmlns:local="using:NyaLauncher.Avalonia.Controls"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="NyaLauncher.Avalonia.Pages.DownloadPage">
  <UserControl.Styles>
    <!-- ===== MD3 列表项：仅状态层反馈（无缩放/位移动画） ===== -->
    <Style Selector="Border.ItemHover">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.ItemHover:pointerover">
      <Setter Property="Background" Value="{DynamicResource HighlightBgBrush}" />
    </Style>

    <!-- ===== Material Design 3 标签页样式（只改 Tab 外观，各标签内容不动） ===== -->
    <Style Selector="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate>
            <Border x:Name="TabRoot"
                    Background="Transparent"
                    CornerRadius="8"
                    Padding="16,10">
              <Grid RowDefinitions="*,Auto">
                <ContentPresenter Content="{TemplateBinding Header}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                <!-- MD3 选中指示条：底部 3px 圆角短条，默认隐藏，选中时亮起 -->
                <Border x:Name="TabIndicator"
                        Grid.Row="1"
                        Height="3"
                        CornerRadius="1.5"
                        Margin="8,5,8,0"
                        HorizontalAlignment="Stretch"
                        Background="{DynamicResource AccentBrush}"
                        IsVisible="False" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- MD3：选中态 → 指示条亮起 + 文字主色 -->
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#TabIndicator">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- MD3：hover → 浅色圆角背景（跟随主题高亮色） -->
    <Style Selector="TabItem:pointerover /template/ Border#TabRoot">
      <Setter Property="Background" Value="{DynamicResource HighlightBgBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" Margin="40,40,40,32">

    <!-- 标题区 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,24">
      <StackPanel Spacing="8" Classes="nya-fade">
        <TextBlock Text="下载大厅"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryTextBrush}" />
        <ProgressBar x:Name="DownloadProgressBar"
                     Minimum="0"
                     Maximum="100"
                     Value="0"
                     IsVisible="False"
                     Height="4"
                     Foreground="{DynamicResource AccentBrush}"
                     Background="{DynamicResource ControlBgBrush}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="DownloadTaskStatusText"
                     Text="当前任务:无"
                     FontSize="11"
                     Foreground="{DynamicResource AccentBrush}"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  x:Name="CancelDownloadButton"
                  Content="取消下载"
                  IsVisible="False"
                  Padding="10,4"
                  CornerRadius="6"
                  FontSize="11"
                  Background="{DynamicResource ButtonBgBrush}"
                  BorderThickness="0"
                  Click="OnCancelDownloadClick"
                  Cursor="Hand"
                  VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
      <Button Grid.Column="1"
              x:Name="RefreshButton"
              Background="{DynamicResource ButtonBgBrush}"
              Foreground="{DynamicResource BodyTextBrush}"
              CornerRadius="8"
              Padding="16,8"
              FontSize="13"
              FontWeight="Medium"
              VerticalAlignment="Bottom"
              Cursor="Hand"
              Margin="0,0,0,2"
              Click="OnRefreshClick"
              RenderTransformOrigin="50%,50%">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <mi:MaterialIcon Kind="Refresh" Width="15" Height="15"
                           Foreground="{DynamicResource BodyTextBrush}"
                           VerticalAlignment="Center" />
          <TextBlock Text="刷新" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- TabControl -->
    <Border Grid.Row="1"
            Background="{DynamicResource PanelBgBrush}"
            CornerRadius="16"
            Padding="0"
            Margin="0">
      <TabControl x:Name="DownloadTabs"
                  BorderThickness="0"
                  Background="{DynamicResource TransparentBrush}"
                  TabStripPlacement="Left"
                  SelectionChanged="OnDownloadTabChanged">

        <!-- ===== Minecraft 本体 ===== -->

        <!-- ===== Minecraft 本体 ===== -->
        <TabItem Header="Minecraft 本体">
          <ScrollViewer>
            <StackPanel Spacing="16" Margin="24,20,24,24">

              <!-- 搜索栏 + 筛选器 -->
              <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="10" Padding="14,10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <mi:MaterialIcon Kind="Magnify" Width="14" Height="14" Foreground="{DynamicResource DisabledTextBrush}" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1"
                           x:Name="VersionSearchBox"
                           PlaceholderText="搜索版本号..."
                           Background="{DynamicResource TransparentBrush}"
                           BorderThickness="0"
                           Foreground="{DynamicResource BodyTextBrush}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           CaretBrush="{DynamicResource BodyTextBrush}"
                           TextChanged="OnVersionSearchChanged" />
                  <ComboBox Grid.Column="2" x:Name="VersionTypeFilter"
                            SelectedIndex="1"
                            Background="{DynamicResource PanelBgBrush}"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="10,4"
                            FontSize="12"
                            Width="110"
                            SelectionChanged="OnVersionFilterChanged">
                    <ComboBox.Items>
                      <ComboBoxItem Content="全部版本" />
                      <ComboBoxItem Content="正式版" />
                      <ComboBoxItem Content="快照版" />
                      <ComboBoxItem Content="远古版本" />
                    </ComboBox.Items>
                  </ComboBox>
                </Grid>
              </Border>

                  <!-- 版本列表 -->
                  <ItemsControl x:Name="VersionList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="models:MinecraftVersion">
                        <Border Classes="ItemHover" Background="{DynamicResource ControlBgBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,4" Cursor="Hand">
                          <Grid ColumnDefinitions="Auto,*">
                            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDeepBrush}" ClipToBounds="True">
                              <local:AsyncImage Width="40" Height="40"
                                                SourceUrl="{Binding TypeIconSource}"
                                                Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
                              <TextBlock Text="{Binding DisplayName}"
                                         FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding TypeDisplay}"
                                           FontSize="12" Foreground="{DynamicResource HintTextBrush}" />
                                <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource DisabledTextBrush}" />
                                <TextBlock Text="{Binding ReleaseDateDisplay}"
                                           FontSize="12" Foreground="{DynamicResource HintTextBrush}" />
                              </StackPanel>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- 底部提示 + 分页 -->
                  <TextBlock x:Name="VersionCountText"
                             FontSize="12" Foreground="{DynamicResource DisabledTextBrush}"
                             HorizontalAlignment="Center" />
                  <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="8" Padding="16,10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Button x:Name="VersionPrevBtn" Content="◀ 上一页"
                              Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource BodyTextBrush}"
                              CornerRadius="6" Padding="14,6" FontSize="12"
                              Cursor="Hand" Click="OnVersionPrevClick" />
                      <TextBlock x:Name="VersionPageText" Grid.Column="1"
                                 Text="第 1 页 / 共 1 页"
                                 FontSize="13" Foreground="{DynamicResource HintTextBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Button x:Name="VersionNextBtn" Grid.Column="2" Content="下一页"
                              Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource BodyTextBrush}"
                              CornerRadius="6" Padding="14,6" FontSize="12"
                              Cursor="Hand" Click="OnVersionNextClick" />
                    </Grid>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- ===== Mod ===== -->
            <TabItem Header="Mod">
              <ScrollViewer>
                <StackPanel Spacing="16" Margin="24,20,24,24">

                  <!-- 搜索栏 -->
                  <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="10" Padding="14,10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <mi:MaterialIcon Kind="Magnify" Width="14" Height="14" Foreground="{DynamicResource DisabledTextBrush}" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               x:Name="ModSearchBox"
                               PlaceholderText="搜索 Mod 名称..."
                               Background="{DynamicResource TransparentBrush}"
                               BorderThickness="0"
                               Foreground="{DynamicResource BodyTextBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               CaretBrush="{DynamicResource BodyTextBrush}"
                               TextChanged="OnModSearchChanged" />
                      <ComboBox Grid.Column="2"
                                x:Name="ModVersionFilter"
                                PlaceholderText="所有版本"
                                Background="{DynamicResource PanelBgBrush}"
                                BorderThickness="0"
                                CornerRadius="6"
                                Padding="10,4"
                                FontSize="12"
                                Width="120"
                                SelectionChanged="OnModVersionFilterChanged" />
                    </Grid>
                  </Border>

                  <!-- Mod 列表 -->
                  <ItemsControl x:Name="ModList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="models:ModrinthProject">
                        <Border Classes="ItemHover" Background="{DynamicResource ControlBgBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,4" Cursor="Hand">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource BadgeBgBrush}" ClipToBounds="True">
                              <Grid>
                                <local:AsyncImage Width="40" Height="40"
                                       SourceUrl="{Binding IconUrl}"
                                       Stretch="UniformToFill" />
                              </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
                              <TextBlock Text="{Binding Title}"
                                         FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                              <TextBlock Text="{Binding Description}"
                                         FontSize="12" Foreground="{DynamicResource HintTextBrush}"
                                         TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2" Margin="0,0,10,0">
                              <TextBlock Text="{Binding DownloadsDisplay}"
                                         FontSize="11" Foreground="{DynamicResource BodyTextBrush}" HorizontalAlignment="Right" />
                              <TextBlock Text="{Binding FollowsDisplay}"
                                         FontSize="11" Foreground="{DynamicResource DisabledTextBrush}" HorizontalAlignment="Right" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- 底部提示 + 分页 -->
                  <TextBlock x:Name="ModCountText"
                             FontSize="12" Foreground="{DynamicResource DisabledTextBrush}"
                             HorizontalAlignment="Center" />
                  <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="8" Padding="16,10">                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Button x:Name="ModPrevBtn" Content="◀ 上一页"
                              Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource BodyTextBrush}"
                              CornerRadius="6" Padding="14,6" FontSize="12"
                              Cursor="Hand" Click="OnModPrevClick" />
                      <TextBlock x:Name="ModPageText" Grid.Column="1"
                                 Text="第 1 页 / 共 1 页"
                                 FontSize="13" Foreground="{DynamicResource HintTextBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Button x:Name="ModNextBtn" Grid.Column="2" Content="下一页"
                              Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource BodyTextBrush}"
                              CornerRadius="6" Padding="14,6" FontSize="12"
                              Cursor="Hand" Click="OnModNextClick" />
                    </Grid>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- ===== 整合包 ===== -->
            <TabItem Header="整合包">
              <ScrollViewer>
                <StackPanel Spacing="16" Margin="24,20,24,24">

                  <!-- 搜索栏 -->
                  <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="10" Padding="14,10">
                    <Grid ColumnDefinitions="Auto,*">
                      <mi:MaterialIcon Kind="Magnify" Width="14" Height="14" Foreground="{DynamicResource DisabledTextBrush}" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               x:Name="ModpackSearchBox"
                               PlaceholderText="搜索整合包..."
                               Background="{DynamicResource TransparentBrush}"
                               BorderThickness="0"
                               Foreground="{DynamicResource BodyTextBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               CaretBrush="{DynamicResource BodyTextBrush}"
                               TextChanged="OnModpackSearchChanged" />
                    </Grid>
                  </Border>

                  <!-- 整合包列表 -->
                  <ItemsControl x:Name="ModpackList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="models:ModrinthProject">
                        <Border Classes="ItemHover" Background="{DynamicResource ControlBgBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,4" Cursor="Hand">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource ErrorDarkBrush}" ClipToBounds="True">
                              <Grid>
                                <local:AsyncImage Width="40" Height="40"
                                       SourceUrl="{Binding IconUrl}"
                                       Stretch="UniformToFill" />
                              </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
                              <TextBlock Text="{Binding Title}"
                                         FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                              <TextBlock Text="{Binding Description}"
                                         FontSize="12" Foreground="{DynamicResource HintTextBrush}"
                                         TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                              <TextBlock Text="{Binding DownloadsDisplay}"
                                         FontSize="11" Foreground="{DynamicResource BodyTextBrush}" HorizontalAlignment="Right" />
                              <TextBlock Text="{Binding FollowsDisplay}"
                                         FontSize="11" Foreground="{DynamicResource DisabledTextBrush}" HorizontalAlignment="Right" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- 底部提示 + 分页 -->
                  <TextBlock x:Name="ModpackCountText"
                             FontSize="12" Foreground="{DynamicResource DisabledTextBrush}"
                             HorizontalAlignment="Center" />
                  <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="8" Padding="16,10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Button x:Name="ModpackPrevBtn" Content="◀ 上一页"
                              Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource BodyTextBrush}"
                              CornerRadius="6" Padding="14,6" FontSize="12"
                              Cursor="Hand" Click="OnModpackPrevClick" />
                      <TextBlock x:Name="ModpackPageText" Grid.Column="1"
                                 Text="第 1 页 / 共 1 页"
                                 FontSize="13" Foreground="{DynamicResource HintTextBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Button x:Name="ModpackNextBtn" Grid.Column="2" Content="下一页"
                              Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource BodyTextBrush}"
                              CornerRadius="6" Padding="14,6" FontSize="12"
                              Cursor="Hand" Click="OnModpackNextClick" />
                    </Grid>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- ===== 光影包 ===== -->
            <TabItem Header="光影包">
              <ScrollViewer>
                <StackPanel Spacing="16" Margin="24,20,24,24">

                  <!-- 搜索栏 -->
                  <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="10" Padding="14,10">
                    <Grid ColumnDefinitions="Auto,*">
                      <mi:MaterialIcon Kind="Magnify" Width="14" Height="14" Foreground="{DynamicResource DisabledTextBrush}" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               x:Name="ShaderSearchBox"
                               PlaceholderText="搜索光影包..."
                               Background="{DynamicResource TransparentBrush}"
                               BorderThickness="0"
                               Foreground="{DynamicResource BodyTextBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               CaretBrush="{DynamicResource BodyTextBrush}"
                               TextChanged="OnShaderSearchChanged" />
                    </Grid>
                  </Border>

                  <!-- 光影包列表 -->
                  <ItemsControl x:Name="ShaderList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="models:ModrinthProject">
                        <Border Classes="ItemHover" Background="{DynamicResource ControlBgBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,4" Cursor="Hand">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource SuccessBrush}" ClipToBounds="True">
                              <Grid>
                                <local:AsyncImage Width="40" Height="40"
                                       SourceUrl="{Binding IconUrl}"
                                       Stretch="UniformToFill" />
                              </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
                              <TextBlock Text="{Binding Title}"
                                         FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                              <TextBlock Text="{Binding Description}"
                                         FontSize="12" Foreground="{DynamicResource HintTextBrush}"
                                         TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                              <TextBlock Text="{Binding DownloadsDisplay}"
                                         FontSize="11" Foreground="{DynamicResource BodyTextBrush}" HorizontalAlignment="Right" />
                              <TextBlock Text="{Binding FollowsDisplay}"
                                         FontSize="11" Foreground="{DynamicResource DisabledTextBrush}" HorizontalAlignment="Right" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- 底部提示 + 分页 -->
                  <TextBlock x:Name="ShaderCountText"
                             FontSize="12" Foreground="{DynamicResource DisabledTextBrush}"
                             HorizontalAlignment="Center" />
                  <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="8" Padding="16,10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Button x:Name="ShaderPrevBtn" Content="◀ 上一页"
                              Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource BodyTextBrush}"
                              CornerRadius="6" Padding="14,6" FontSize="12"
                              Cursor="Hand" Click="OnShaderPrevClick" />
                      <TextBlock x:Name="ShaderPageText" Grid.Column="1"
                                 Text="第 1 页 / 共 1 页"
                                 FontSize="13" Foreground="{DynamicResource HintTextBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Button x:Name="ShaderNextBtn" Grid.Column="2" Content="下一页"
                              Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource BodyTextBrush}"
                              CornerRadius="6" Padding="14,6" FontSize="12"
                              Cursor="Hand" Click="OnShaderNextClick" />
                    </Grid>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- ===== 材质包 ===== -->
            <TabItem Header="材质包">
              <ScrollViewer>
                <StackPanel Spacing="16" Margin="24,20,24,24">

                  <!-- 搜索栏 -->
                  <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="10" Padding="14,10">
                    <Grid ColumnDefinitions="Auto,*">
                      <mi:MaterialIcon Kind="Magnify" Width="14" Height="14" Foreground="{DynamicResource DisabledTextBrush}" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               x:Name="ResourcepackSearchBox"
                               PlaceholderText="搜索材质包..."
                               Background="{DynamicResource TransparentBrush}"
                               BorderThickness="0"
                               Foreground="{DynamicResource BodyTextBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               CaretBrush="{DynamicResource BodyTextBrush}"
                               TextChanged="OnResourcepackSearchChanged" />
                    </Grid>
                  </Border>

                  <!-- 材质包列表 -->
                  <ItemsControl x:Name="ResourcepackList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="models:ModrinthProject">
                        <Border Classes="ItemHover" Background="{DynamicResource ControlBgBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,4" Cursor="Hand">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource BadgeBgBrush}" ClipToBounds="True">
                              <Grid>
                                <local:AsyncImage Width="40" Height="40"
                                       SourceUrl="{Binding IconUrl}"
                                       Stretch="UniformToFill" />
                              </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
                              <TextBlock Text="{Binding Title}"
                                         FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                              <TextBlock Text="{Binding Description}"
                                         FontSize="12" Foreground="{DynamicResource HintTextBrush}"
                                         TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                              <TextBlock Text="{Binding DownloadsDisplay}"
                                         FontSize="11" Foreground="{DynamicResource BodyTextBrush}" HorizontalAlignment="Right" />
                              <TextBlock Text="{Binding FollowsDisplay}"
                                         FontSize="11" Foreground="{DynamicResource DisabledTextBrush}" HorizontalAlignment="Right" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- 底部提示 + 分页 -->
                  <TextBlock x:Name="ResourcepackCountText"
                             FontSize="12" Foreground="{DynamicResource DisabledTextBrush}"
                             HorizontalAlignment="Center" />
                  <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="8" Padding="16,10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Button x:Name="ResourcepackPrevBtn" Content="◀ 上一页"
                              Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource BodyTextBrush}"
                              CornerRadius="6" Padding="14,6" FontSize="12"
                              Cursor="Hand" Click="OnResourcepackPrevClick" />
                      <TextBlock x:Name="ResourcepackPageText" Grid.Column="1"
                                 Text="第 1 页 / 共 1 页"
                                 FontSize="13" Foreground="{DynamicResource HintTextBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Button x:Name="ResourcepackNextBtn" Grid.Column="2" Content="下一页"
                              Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource BodyTextBrush}"
                              CornerRadius="6" Padding="14,6" FontSize="12"
                              Cursor="Hand" Click="OnResourcepackNextClick" />
                    </Grid>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Java">
              <ScrollViewer>
                <StackPanel Spacing="16" Margin="24,20">

                  <!-- 标题区 -->
                  <StackPanel Spacing="6">
                    <TextBlock Text="Java 运行时管理"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock x:Name="JavaPlatformText"
                               FontSize="12"
                               Foreground="{DynamicResource HintTextBrush}" />
                  </StackPanel>

                  <!-- 版本选择建议 -->
                  <Border Background="{DynamicResource PanelBgBrush}"
                          CornerRadius="14"
                          Padding="20,16"
                          Classes="nya-lift nya-shimmer">
                    <StackPanel Spacing="10">
                      <TextBlock Text="版本选择建议"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource PrimaryTextBrush}" />
                      <Grid ColumnDefinitions="80,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                        <TextBlock Text="Java 8"
                                   Grid.Row="0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                   FontSize="12"
                                   Foreground="{DynamicResource BodyTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="适用于 Minecraft 1.8 ~ 1.16.x（老版本必须使用 Java 8）" />

                        <TextBlock Text="Java 11"
                                   Grid.Row="1"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                   FontSize="12"
                                   Foreground="{DynamicResource BodyTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="适用于 1.12 ~ 1.16.x 的部分模组环境" />

                        <TextBlock Text="Java 17"
                                   Grid.Row="2"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                   FontSize="12"
                                   Foreground="{DynamicResource BodyTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="适用于 Minecraft 1.17 ~ 1.20.x 及常见模组" />

                        <TextBlock Text="Java 21"
                                   Grid.Row="3"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                   FontSize="12"
                                   Foreground="{DynamicResource BodyTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="适用于 Minecraft 1.20.5+、最新快照与 NeoForge 21.x" />

                        <TextBlock Text="Java 25"
                                   Grid.Row="4"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                   FontSize="12"
                                   Foreground="{DynamicResource BodyTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="适用于最新快照与未来版本（Zulu/Temurin 提供）" />
                      </Grid>
                      <TextBlock Text="下载多套 Java 不会冲突，启动器会按版本自动选择最合适的一套。"
                                 FontSize="11"
                                 Foreground="{DynamicResource DisabledTextBrush}" />
                    </StackPanel>
                  </Border>

                  <!-- 下载卡片 -->
                  <Border Background="{DynamicResource PanelBgBrush}"
                          CornerRadius="14"
                          Padding="20,16"
                          Classes="nya-lift nya-shimmer">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                          <TextBlock Text="下载 JDK"
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource PrimaryTextBrush}" />
                          <TextBlock Text="按当前平台自动选择安装包（zip / tar.gz），下载完成后校验并安装"
                                     FontSize="11"
                                     Foreground="{DynamicResource HintTextBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Padding="12,6"
                                CornerRadius="8"
                                FontSize="11"
                                Background="{DynamicResource ButtonBgBrush}"
                                BorderBrush="{DynamicResource EmphasizedBorderBrush}"
                                BorderThickness="1"
                                Foreground="{DynamicResource LinkTextColorBrush}"
                                Cursor="Hand"
                                Click="OnRefreshJavaRuntimeClick">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <mi:MaterialIcon Kind="Refresh" Width="13" Height="13"
                                             Foreground="{DynamicResource LinkTextColorBrush}"
                                             VerticalAlignment="Center" />
                            <TextBlock Text="刷新列表" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </Grid>

                      <Grid ColumnDefinitions="200,*" ColumnSpacing="16">
                        <!-- 左侧：JDK 提供商 -->
                        <StackPanel Spacing="6">
                          <TextBlock Text="JDK 提供商"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource SecondaryTextBrush}" />
                          <ComboBox x:Name="JavaVendorComboBox"
                                    Background="{DynamicResource ControlBgBrush}"
                                    BorderThickness="0"
                                    CornerRadius="8"
                                    Padding="10,7"
                                    FontSize="12"
                                    SelectionChanged="OnJavaVendorChanged" />
                          <TextBlock x:Name="JavaVendorHintText"
                                     FontSize="11"
                                     Foreground="{DynamicResource HintTextBrush}"
                                     TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 右侧：实时版本列表 -->
                        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
                          <TextBlock Text="可用版本（实时获取）"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource SecondaryTextBrush}" />
                          <ListBox x:Name="JavaVersionList"
                                   Grid.Row="1"
                                   Margin="0,6,0,8"
                                   MinHeight="120"
                                   MaxHeight="220"
                                   Background="{DynamicResource ControlBgBrush}"
                                   BorderThickness="0"
                                   CornerRadius="8"
                                   Padding="6"
                                   SelectionChanged="OnJavaVersionSelected">
                            <ListBox.ItemTemplate>
                              <DataTemplate DataType="{x:Type download:JavaDownloadCandidate}">
                                <Border Background="{DynamicResource CardBgBrush}"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="0,2">
                                  <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="{Binding DetailText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource HintTextBrush}" />
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                          <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="JavaSelectionInfo"
                                       FontSize="12"
                                       Foreground="{DynamicResource AccentTextColorBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1"
                                    x:Name="DownloadJavaButton"
                                    Padding="14,9"
                                    CornerRadius="8"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Background="{DynamicResource AccentBrush}"
                                    Cursor="Hand"
                                    Click="OnDownloadJavaClick">
                              <StackPanel Orientation="Horizontal" Spacing="5">
                                <mi:MaterialIcon Kind="ArrowDown"
                                       Width="14" Height="14"
                                       Foreground="White"
                                       VerticalAlignment="Center" />
                                <TextBlock Text="下载所选" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WhiteBrush}"
                                           VerticalAlignment="Center" />
                              </StackPanel>
                            </Button>
                          </Grid>
                        </Grid>
                      </Grid>

                      <ProgressBar x:Name="JavaDownloadProgressBar"
                                   Minimum="0"
                                   Maximum="100"
                                   Value="0"
                                   IsVisible="False"
                                   Height="6"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Background="{DynamicResource ControlBgBrush}" />
                      <TextBlock x:Name="JavaDownloadStatusText"
                                 FontSize="12"
                                 Foreground="{DynamicResource AccentTextColorBrush}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <!-- 已安装列表 -->
                  <Border Background="{DynamicResource PanelBgBrush}"
                          CornerRadius="14"
                          Padding="20,16"
                          Classes="nya-lift nya-shimmer">
                    <StackPanel Spacing="10">
                      <StackPanel Spacing="2">
                        <TextBlock Text="已安装的 Java 运行时"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="「使用此 Java」设为全局路径；「删除」移除此运行时"
                                   FontSize="11"
                                   Foreground="{DynamicResource HintTextBrush}" />
                      </StackPanel>
                      <ItemsControl x:Name="JavaRuntimeList">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type download:InstalledJavaRuntime}">
                            <Border Background="{DynamicResource CardBgBrush}"
                                    CornerRadius="10"
                                    Padding="14,10"
                                    Margin="0,0,0,8">
                              <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding JavaExecutablePath}"
                                           FontSize="11"
                                           Foreground="{DynamicResource HintTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="14,0"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="2"
                                        Content="使用此 Java"
                                        Tag="{Binding}"
                                        Padding="12,6"
                                        CornerRadius="8"
                                        FontSize="11"
                                        Margin="0,0,8,0"
                                        Background="{DynamicResource ButtonBgBrush}"
                                        BorderBrush="{DynamicResource EmphasizedBorderBrush}"
                                        BorderThickness="1"
                                        Foreground="{DynamicResource LinkTextColorBrush}"
                                        Cursor="Hand"
                                        Click="OnUseJavaRuntimeClick" />
                                <Button Grid.Column="3"
                                        Content="删除"
                                        Tag="{Binding}"
                                        Padding="12,6"
                                        CornerRadius="8"
                                        FontSize="11"
                                        Background="{DynamicResource ButtonBgBrush}"
                                        BorderBrush="{DynamicResource EmphasizedBorderBrush}"
                                        BorderThickness="1"
                                        Foreground="{DynamicResource ErrorBrush}"
                                        Cursor="Hand"
                                        Click="OnDeleteJavaRuntimeClick" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock x:Name="JavaRuntimeEmptyText"
                                 Text="尚未安装自动下载的 Java 运行时，选择上方供应商与版本后开始下载。"
                                 FontSize="12"
                                 Foreground="{DynamicResource DisabledTextBrush}" />
                    </StackPanel>
                  </Border>

                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
    </Border>
    <!-- 全屏加载遮罩 -->
    <Border x:Name="LoadingOverlay"
            Grid.Row="1"
            Background="{DynamicResource OverlayBgBrush}"
            CornerRadius="16"
            IsVisible="True">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
        <mi:MaterialIcon x:Name="LoadingSpinner" Kind="HourglassEmpty" Width="44" Height="44"
                         Foreground="{DynamicResource BodyTextBrush}"
                         HorizontalAlignment="Center" RenderTransformOrigin="50%,50%" Classes="nya-spin" />
        <TextBlock Text="正在加载资源…" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource BodyTextBrush}" HorizontalAlignment="Center" />
        <TextBlock x:Name="LoadingDetail" Text="正在连接 Modrinth API…"
                   FontSize="13" Foreground="{DynamicResource DisabledTextBrush}" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Minecraft 下载选项遮罩宿主 -->
    <local:ModalOverlayHost x:Name="DownloadOverlay"
                            Grid.Row="0" Grid.RowSpan="2" />
  </Grid>
</UserControl>
