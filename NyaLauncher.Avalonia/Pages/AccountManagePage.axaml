<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:NyaLauncher.Avalonia.Pages"
             xmlns:controls="using:NyaLauncher.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="NyaLauncher.Avalonia.Pages.AccountManagePage"
             Loaded="Control_OnLoaded">
  <Grid RowDefinitions="Auto,*,Auto" Margin="40,40,40,32">

    <!-- 标题区 -->
    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,24">
      <TextBlock Text="账户管理"
                 FontSize="28"
                 FontWeight="Bold"
                 Foreground="#FFFFFF" />
      <TextBlock Text="管理正版与离线账号，切换默认账号，并编辑玩家外观"
                 FontSize="13"
                 Foreground="#8B8B9E" />
    </StackPanel>

    <!-- 主卡片：工具栏 + 账号列表 -->
    <Border Grid.Row="1"
            Background="#1E1E2E"
            CornerRadius="16"
            Padding="24,20">
      <Grid RowDefinitions="Auto,*">

        <!-- 工具栏：选择账号后点击上方按钮执行操作 -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="10">
          <StackPanel VerticalAlignment="Center" Spacing="3">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock x:Name="SelectedAccountText"
                         Text="未选择账号"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="#FFFFFF" />
              <Border x:Name="SelectedDefaultBadge"
                      Background="#2D3450"
                      CornerRadius="6"
                      Padding="7,2"
                      IsVisible="False"
                      VerticalAlignment="Center">
                <TextBlock Text="默认账号"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#AEB6FF" />
              </Border>
            </StackPanel>
            <TextBlock x:Name="SelectedAccountDetailText"
                       Text="请选择一个账号，再使用右侧工具按钮"
                       FontSize="12"
                       Foreground="#8B8B9E" />
          </StackPanel>

          <Button Grid.Column="1"
                  Content="＋ 添加账户"
                  Background="{StaticResource SystemAccentColor}"
                  Foreground="White"
                  CornerRadius="8"
                  Padding="16,7"
                  FontSize="13"
                  FontWeight="SemiBold"
                  VerticalAlignment="Center"
                  Cursor="Hand"
                  Click="OnAddAccountClick"
                  ToolTip.Tip="添加正版（微软设备码登录）或离线账号" />

          <Button Grid.Column="2"
                  Content="设为默认"
                  Background="#2D2D44"
                  Foreground="#CCCCDD"
                  CornerRadius="8"
                  Padding="14,7"
                  FontSize="13"
                  VerticalAlignment="Center"
                  Cursor="Hand"
                  Click="OnSetDefaultClick"
                  ToolTip.Tip="把选中账号设为默认，启动游戏时优先使用" />

          <Button Grid.Column="3"
                  Content="更换皮肤"
                  Background="#2D2D44"
                  Foreground="#CCCCDD"
                  CornerRadius="8"
                  Padding="14,7"
                  FontSize="13"
                  VerticalAlignment="Center"
                  Cursor="Hand"
                  Click="OnChangeSkinClick"
                  ToolTip.Tip="正版账号上传 PNG 皮肤；离线账号从内置默认皮肤中选择" />

          <Button x:Name="ChangeCapeButton"
                  Grid.Column="4"
                  Content="更换披风"
                  Background="#2D2D44"
                  Foreground="#CCCCDD"
                  CornerRadius="8"
                  Padding="14,7"
                  FontSize="13"
                  VerticalAlignment="Center"
                  Cursor="Hand"
                  Click="OnChangeCapeClick"
                  ToolTip.Tip="从该正版账号已经拥有的披风中切换" />

          <Button Grid.Column="5"
                  Content="删除账户"
                  Background="Transparent"
                  Foreground="#E56B6B"
                  CornerRadius="8"
                  Padding="14,7"
                  FontSize="13"
                  VerticalAlignment="Center"
                  Cursor="Hand"
                  Click="OnDeleteAccountClick"
                  ToolTip.Tip="删除选中账号（不可恢复）" />
        </Grid>

        <!-- 账号列表 -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ListBox x:Name="AccountList"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionChanged="OnAccountSelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="local:AccountListItem" x:CompileBindings="False">
                  <Border Background="#2A2A3E"
                          CornerRadius="12"
                          Padding="16,12"
                          Margin="0,0,0,10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                      <!-- 头像：优先显示皮肤贴图，加载失败时回退到字母占位 -->
                      <Border Width="54"
                              Height="54"
                              CornerRadius="10"
                              Background="#3A3A50"
                              ClipToBounds="True">
                        <Grid>
                          <TextBlock Text="{Binding AvatarFallback}"
                                     FontSize="22"
                                     FontWeight="Bold"
                                     Foreground="{StaticResource SystemAccentColor}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                          <controls:AsyncImage SourceUrl="{Binding AvatarSource}"
                                               CropRect="8,8,8,8"
                                               RenderOptions.BitmapInterpolationMode="None"
                                               Width="54"
                                               Height="54"
                                               Stretch="Uniform" />
                        </Grid>
                      </Border>

                      <StackPanel Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding DisplayName}"
                                     FontSize="15"
                                     FontWeight="SemiBold"
                                     Foreground="#FFFFFF" />
                          <Border Background="#2D3450"
                                  CornerRadius="6"
                                  Padding="7,2"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding TypeLabel}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#AEB6FF" />
                          </Border>
                          <Border Background="#24303B"
                                  CornerRadius="6"
                                  Padding="7,2"
                                  IsVisible="{Binding IsDefault}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="默认"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#62D49A" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}"
                                   FontSize="11"
                                   Foreground="#8B8B9E"
                                   TextWrapping="Wrap" />
                      </StackPanel>

                      <!-- 右侧：当前账号标记 -->
                      <TextBlock Grid.Column="2"
                                 Text="当前"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource SystemAccentColor}"
                                 IsVisible="{Binding IsDefault}"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>

          <!-- 空列表提示 -->
          <StackPanel x:Name="EmptyHintPanel"
                      IsVisible="False"
                      Spacing="8"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <TextBlock Text="☺"
                       FontSize="40"
                       Foreground="#6674DB"
                       HorizontalAlignment="Center" />
            <TextBlock Text="还没有任何账号"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#DDE2F4"
                       HorizontalAlignment="Center" />
            <TextBlock Text="点击上方「＋ 添加账户」新建账号，支持正版（微软设备码登录）与离线账号"
                       FontSize="12"
                       Foreground="#8B8B9E"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- 底部状态提示 -->
    <TextBlock x:Name="StatusText"
               Grid.Row="2"
               FontSize="12"
               Foreground="#8B8B9E"
               TextWrapping="Wrap"
               HorizontalAlignment="Center"
               Margin="0,18,0,0" />

    <!-- 新建账户 / 设备码 遮罩（共享控件） -->
    <local:AccountLoginOverlay x:Name="AccountLoginOverlay" Grid.RowSpan="3" />
  </Grid>
</UserControl>
