<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NyaLauncher.Avalonia.Controls"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="NyaLauncher.Avalonia.Pages.VersionManagerPage"
             Background="{DynamicResource WindowBgBrush}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="26,22">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,18">
      <TextBlock Text="版本管理"
                 FontSize="23"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource PrimaryTextBrush}" />
      <ComboBox x:Name="FolderSelector"
                Grid.Column="1"
                MinWidth="280"
                Height="42"
                PlaceholderText="选择已添加的 Minecraft 文件夹"
                VerticalAlignment="Center"
                SelectionChanged="OnFolderSelectionChanged" />
      <Button Grid.Column="2"
              Content="重新扫描"
              Margin="10,0,0,0"
              Padding="14,8"
              VerticalAlignment="Center"
              Click="OnRefreshClick" />
      <Button Grid.Column="3"
              Content="打开游戏文件夹"
              Margin="8,0,0,0"
              Padding="14,8"
              VerticalAlignment="Center"
              Click="OnOpenGameFolderClick" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="250,16,*">
      <Border Background="{DynamicResource PanelBgBrush}"
              BorderBrush="{DynamicResource MediumBorderBrush}"
              BorderThickness="1"
              CornerRadius="13"
              Padding="12">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Text="实例版本"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Margin="4,2,4,10" />
          <ListBox x:Name="VersionList"
                   Grid.Row="1"
                   Classes="nya-stagger"
                   Background="{DynamicResource TransparentBrush}"
                   BorderThickness="0"
                   SelectionChanged="OnVersionSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <local:InstanceListItem />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="InstanceCountText"
                     Grid.Row="2"
                     Text="0 个实例"
                     FontSize="10"
                     Foreground="{DynamicResource DisabledTextBrush}"
                     Margin="4,10,4,2" />
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Background="{DynamicResource CardBgBrush}"
              BorderBrush="{DynamicResource MediumBorderBrush}"
              BorderThickness="1"
              CornerRadius="13"
              Padding="20">
        <Grid>
        <Grid x:Name="EmptyDetailsView">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
            <mi:MaterialIcon Kind="Apps"
                   Width="40" Height="40"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   HorizontalAlignment="Center" />
            <TextBlock Text="请选择一个实例版本"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="选择后可以查看详情、内容与启动设置"
                       FontSize="11"
                       Foreground="{DynamicResource SubtextTextBrush}" />
          </StackPanel>
        </Grid>

        <Grid x:Name="DetailsView" IsVisible="False" RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,14">
            <Border Width="48" Height="48" CornerRadius="9" Background="{DynamicResource BadgeBgBrush}" ClipToBounds="True" Margin="0,0,12,0">
              <Grid>
                <ContentControl x:Name="DetailsIconGlyph"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                <local:AsyncImage x:Name="DetailsIconImage"
                                  Width="48"
                                  Height="48"
                                  Stretch="Uniform" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock x:Name="DetailsTitleText"
                         Text="实例详情"
                         FontSize="21"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource PrimaryTextBrush}" />
              <TextBlock x:Name="DetailsSubtitleText"
                         Text="Minecraft"
                         FontSize="11"
                         Foreground="{DynamicResource SubtextTextBrush}" />
            </StackPanel>
            <Button Grid.Column="2"
                    Content="打开版本文件夹"
                    Margin="10,0,0,0"
                    Padding="13,7"
                    VerticalAlignment="Center"
                    Click="OnOpenVersionFolderClick" />
            <Button Grid.Column="3"
                    Content="打开模组文件夹"
                    Margin="8,0,0,0"
                    Padding="13,7"
                    VerticalAlignment="Center"
                    Click="OnOpenModsFolderClick" />
            <Button Grid.Column="4"
                    Content="打开存档文件夹"
                    Margin="8,0,0,0"
                    Padding="13,7"
                    VerticalAlignment="Center"
                    Click="OnOpenSavesFolderClick" />
          </Grid>

          <TabControl Grid.Row="1">
            <TabItem Header="版本">
              <ScrollViewer>
                <StackPanel Margin="14" Spacing="12">
                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Text="实际版本 ID" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="VersionIdText" Grid.Column="1" Foreground="{DynamicResource TertiaryTextBrush}" />
                  </Grid>
                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Text="Minecraft 基础版本" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="BaseGameVersionText" Grid.Column="1" Foreground="{DynamicResource TertiaryTextBrush}" />
                  </Grid>
                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Text="版本类型" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="VersionTypeText" Grid.Column="1" Foreground="{DynamicResource TertiaryTextBrush}" />
                  </Grid>
                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Text="模组加载器" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="LoaderText" Grid.Column="1" Foreground="{DynamicResource TertiaryTextBrush}" />
                  </Grid>
                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Text="模组加载器版本" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="LoaderVersionText" Grid.Column="1" Foreground="{DynamicResource TertiaryTextBrush}" />
                  </Grid>
                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Text="版本隔离" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="IsolationText" Grid.Column="1" Foreground="{DynamicResource TertiaryTextBrush}" />
                  </Grid>
                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Text="布局识别来源" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="LayoutProviderText"
                               Grid.Column="1"
                               Foreground="{DynamicResource TertiaryTextBrush}"
                               TextWrapping="Wrap" />
                  </Grid>
                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Text="实例内容目录" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="ContentDirectoryText"
                               Grid.Column="1"
                               Foreground="{DynamicResource TertiaryTextBrush}"
                               TextWrapping="Wrap" />
                  </Grid>
                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Text="发布时间" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="ReleaseTimeText" Grid.Column="1" Foreground="{DynamicResource TertiaryTextBrush}" />
                  </Grid>
                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Text="Java 要求" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="JavaRequirementText" Grid.Column="1" Foreground="{DynamicResource TertiaryTextBrush}" />
                  </Grid>
                  <Grid ColumnDefinitions="150,*">
                    <TextBlock Text="主类" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="MainClassText"
                               Grid.Column="1"
                               Foreground="{DynamicResource TertiaryTextBrush}"
                               TextWrapping="Wrap" />
                  </Grid>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="启动设置">
              <ScrollViewer>
                <StackPanel Margin="14" Spacing="12">
                  <CheckBox x:Name="VersionIsolationCheckBox"
                            Content="开启版本隔离（模组、资源包、光影、配置和存档使用识别到的实例内容目录）"
                            Foreground="{DynamicResource SecondaryTextBrush}" />
                  <StackPanel Spacing="8">
                    <CheckBox x:Name="IndependentMemoryCheckBox"
                              Content="独立调整（关闭时锁定下方滑块并使用全局内存设置）"
                              Foreground="{DynamicResource SecondaryTextBrush}"
                              IsCheckedChanged="OnIndependentMemoryChanged" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="实例最小内存" Foreground="{DynamicResource MutedTextBrush}" />
                      <TextBlock x:Name="MinimumMemoryValueText"
                                 Grid.Column="1"
                                 Text="512 MiB"
                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                 FontWeight="SemiBold" />
                    </Grid>
                    <Slider x:Name="MinimumMemorySlider"
                            Minimum="256"
                            Maximum="4096"
                            TickFrequency="256"
                            TickPlacement="BottomRight"
                            IsSnapToTickEnabled="True"
                            ValueChanged="OnInstanceMemoryValueChanged" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                      <TextBlock Text="实例最大内存" Foreground="{DynamicResource MutedTextBrush}" />
                      <TextBlock x:Name="MaximumMemoryValueText"
                                 Grid.Column="1"
                                 Text="4096 MiB"
                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                 FontWeight="SemiBold" />
                    </Grid>
                    <Slider x:Name="MaximumMemorySlider"
                            Minimum="512"
                            Maximum="4096"
                            TickFrequency="256"
                            TickPlacement="BottomRight"
                            IsSnapToTickEnabled="True"
                            ValueChanged="OnInstanceMemoryValueChanged" />
                    <TextBlock x:Name="InstanceMemoryPolicyText"
                               Text="实际最大内存不会超过设置页中的全局上限。"
                               FontSize="11"
                               Foreground="{DynamicResource HintTextBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <Expander Header="高级选项" IsExpanded="False">
                    <StackPanel Spacing="10" Margin="0,8,0,0">
                      <CheckBox x:Name="FollowGlobalAdvancedSettingsCheckBox"
                                Content="跟随全局高级启动设置（默认开启；关闭后才能自定义）"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                IsCheckedChanged="OnFollowGlobalAdvancedSettingsChanged" />
                      <Grid ColumnDefinitions="*,12,*">
                    <StackPanel>
                      <TextBlock Text="窗口宽度" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" />
                      <TextBox x:Name="WindowWidthBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="窗口高度" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" />
                      <TextBox x:Name="WindowHeightBox" />
                    </StackPanel>
                      </Grid>
                      <TextBlock Text="Java 可执行文件（留空时自动检测）" Foreground="{DynamicResource MutedTextBrush}" />
                      <TextBox x:Name="JavaExecutableBox" />
                      <TextBlock Text="额外 JVM 参数（每行一个参数）" Foreground="{DynamicResource MutedTextBrush}" />
                      <TextBox x:Name="JvmArgumentsBox" AcceptsReturn="True" MinHeight="72" />
                      <TextBlock Text="额外游戏参数（每行一个参数）" Foreground="{DynamicResource MutedTextBrush}" />
                      <TextBox x:Name="GameArgumentsBox" AcceptsReturn="True" MinHeight="72" />
                    </StackPanel>
                  </Expander>
                  <Button Content="保存实例设置"
                          HorizontalAlignment="Left"
                          Padding="18,8"
                          Background="{DynamicResource AccentDeepBrush}"
                          Foreground="{DynamicResource WhiteBrush}"
                          Click="OnSaveSettingsClick" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="编辑实例">
              <ScrollViewer>
                <StackPanel Margin="14" Spacing="14">
                  <StackPanel Spacing="4">
                    <TextBlock Text="实例图标" Foreground="{DynamicResource MutedTextBrush}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <ComboBox x:Name="InstanceIconCombo"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnInstanceIconComboChanged" />
                      <Button x:Name="ClearInstanceIconButton"
                              Grid.Column="1"
                              Content="恢复默认"
                              Padding="11,6"
                              Click="OnClearInstanceIconClick" />
                    </Grid>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="实例名称（将直接重命名版本文件夹与文件）" Foreground="{DynamicResource MutedTextBrush}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox x:Name="VersionNameBox" PlaceholderText="输入新的实例名称" />
                      <Button Grid.Column="1"
                              Content="重命名"
                              Padding="14,7"
                              Click="OnRenameInstanceClick" />
                    </Grid>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="导出为整合包" Foreground="{DynamicResource MutedTextBrush}" />
                    <Button Content="导出为整合包"
                            HorizontalAlignment="Left"
                            Padding="18,8"
                            IsEnabled="False" />
                    <TextBlock Text="功能开发中，敬请期待。"
                               FontSize="11"
                               Foreground="{DynamicResource HintTextBrush}" />
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="危险操作" Foreground="{DynamicResource MutedTextBrush}" />
                    <Button Content="删除实例"
                            HorizontalAlignment="Left"
                            Padding="18,8"
                            Background="{DynamicResource ErrorBrush}"
                            Foreground="{DynamicResource WhiteBrush}"
                            Click="OnDeleteInstanceClick" />
                    <TextBlock Text="删除操作不可恢复，将移除版本文件夹及其全部内容。"
                               FontSize="11"
                               Foreground="{DynamicResource HintTextBrush}" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="已安装模组">
              <Grid Margin="14" RowDefinitions="Auto,Auto,*">
                <TextBlock x:Name="ModsSummaryText"
                           Text="0 个模组"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <Border x:Name="ModLoaderHint"
                        Grid.Row="1"
                        Background="{DynamicResource BadgeBgBrush}"
                        BorderBrush="{DynamicResource EmphasizedBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,10,0,8">
                  <TextBlock Text="当前是原版实例。安装 Fabric、Forge、NeoForge 或 Quilt 后才能加载模组。"
                             Foreground="{DynamicResource WarningBrush}"
                             TextWrapping="Wrap" />
                </Border>
                <ListBox x:Name="ModsList"
                         Grid.Row="2"
                         Margin="0,8,0,0"
                         Background="{DynamicResource TransparentBrush}"
                         BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <local:ContentEntryItem />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </TabItem>

            <TabItem Header="资源包">
              <Grid Margin="14" RowDefinitions="Auto,*">
                <TextBlock x:Name="ResourcePacksSummaryText"
                           Text="0 个资源包"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <ListBox x:Name="ResourcePacksList"
                         Grid.Row="1"
                         Margin="0,10,0,0"
                         Background="{DynamicResource TransparentBrush}"
                         BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <local:ContentEntryItem />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </TabItem>

            <TabItem x:Name="ShadersTab" Header="光影">
              <Grid Margin="14" RowDefinitions="Auto,*">
                <TextBlock x:Name="ShadersSummaryText"
                           Text="0 个光影"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <ListBox x:Name="ShadersList"
                         Grid.Row="1"
                         Margin="0,10,0,0"
                         Background="{DynamicResource TransparentBrush}"
                         BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <local:ContentEntryItem />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </TabItem>

            <TabItem Header="游戏存档">
              <Grid Margin="14" RowDefinitions="Auto,*">
                <TextBlock x:Name="SavesSummaryText"
                           Text="0 个存档"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <ListBox x:Name="SavesList"
                         Grid.Row="1"
                         Margin="0,10,0,0"
                         Background="{DynamicResource TransparentBrush}"
                         BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <local:SaveEntryItem />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </TabItem>

            <TabItem Header="插件操作">
              <Grid Margin="14" RowDefinitions="Auto,Auto,*">
                <TextBlock Text="由已启用插件提供的实例操作"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BodyTextBrush}" />
                <TextBlock x:Name="PluginActionsEmptyText"
                           Grid.Row="1"
                           Text="当前没有可用的插件操作。可在插件列表中启用支持实例修改的插件。"
                           Margin="0,10,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource HintTextBrush}"
                           TextWrapping="Wrap" />
                <ListBox x:Name="PluginActionsList"
                         Grid.Row="2"
                         Margin="0,10,0,0"
                         Background="Transparent"
                         BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                      <Border Margin="0,0,0,9"
                              Padding="13"
                              Background="{DynamicResource SurfaceBgBrush}"
                              BorderBrush="{DynamicResource DefaultBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="9">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Width="38"
                                  Height="38"
                                  Margin="0,0,12,0"
                                  Background="{DynamicResource IconBoxBgBrush}"
                                  CornerRadius="8">
                            <TextBlock Text="{Binding Glyph}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="17"
                                       Foreground="{DynamicResource AccentTextBrush}" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{Binding PluginLabel}"
                                       FontSize="10"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="{Binding Description}"
                                       MaxWidth="560"
                                       FontSize="11"
                                       Foreground="{DynamicResource TertiaryTextBrush}"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel Grid.Column="2"
                                      Margin="14,0,0,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Spacing="7">
                            <TextBlock Text="{Binding RiskLabel}"
                                       HorizontalAlignment="Center"
                                       FontSize="9"
                                       Foreground="{DynamicResource WarningBrush}" />
                            <Button Content="执行"
                                    Padding="15,7"
                                    Click="OnPluginActionClick" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </TabItem>
          </TabControl>
        </Grid>
        </Grid>
      </Border>
    </Grid>

    <TextBlock x:Name="StatusText"
               Grid.Row="2"
               Text="请选择一个 Minecraft 文件夹"
               FontSize="11"
               Foreground="{DynamicResource SubtextTextBrush}"
               Margin="2,13,0,0"
               TextWrapping="Wrap" />
  </Grid>
</UserControl>
