<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NyaLauncher.Avalonia.Pages.SettingsHubPage"
             Background="#0D101A">
  <UserControl.Styles>
    <Style Selector="TabItem">
      <Setter Property="Foreground" Value="#8F98B3" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,10" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="#F4F6FF" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            Background="#121624"
            BorderBrush="#252B3D"
            BorderThickness="0,0,0,1"
            Padding="28,15,28,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="3">
          <TextBlock Text="设置"
                     FontSize="21"
                     FontWeight="Bold"
                     Foreground="#F5F6FF" />
          <TextBlock Text="启动器配置、运行环境与工作区个性化"
                     FontSize="11"
                     Foreground="#77809B" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Text="按 Esc 可随时进入此页面"
                   FontSize="11"
                   Foreground="#8F98B3"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <TabControl x:Name="SettingsTabs"
                Grid.Row="1"
                Background="Transparent"
                BorderThickness="0">
      <TabItem Header="启动器设置">
        <ContentControl x:Name="LegacySettingsHost" />
      </TabItem>
      <TabItem Header="个性化">
        <ContentControl x:Name="PersonalizationHost" />
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
