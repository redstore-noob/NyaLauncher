<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="NyaLauncher.Avalonia.Pages.SettingsHubPage"
             Background="{DynamicResource WindowBgBrush}">
  <UserControl.Styles>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- 顶部标题栏 -->
    <Border Grid.Row="0"
            Background="{DynamicResource BaseBgBrush}"
            BorderBrush="{DynamicResource SubtleBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="28,15,28,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="3">
          <TextBlock Text="设置"
                     FontSize="21"
                     FontWeight="Bold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
          <TextBlock Text="启动器配置、运行环境与工作区个性化"
                     FontSize="11"
                     Foreground="{DynamicResource HintTextBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 左侧标签 + 右侧内容 -->
    <Grid Grid.Row="1" ColumnDefinitions="220,*">

      <!-- 左侧标签栏 -->
      <Border Background="{DynamicResource BaseBgBrush}"
              BorderBrush="{DynamicResource SubtleBorderBrush}"
              BorderThickness="0,0,1,0">
        <StackPanel Spacing="0">
          <!-- 搜索 / 标签标题 -->
          <TextBlock Text="分类"
                     FontSize="10"
                     FontWeight="Bold"
                     Foreground="{DynamicResource DisabledTextBrush}"
                     Margin="20,16,20,10"
                     LetterSpacing="1" />

          <!-- 游戏设置 -->
          <Border x:Name="TabGame"
                  Background="{DynamicResource TransparentBrush}"
                  CornerRadius="8"
                  Margin="8,2"
                  Padding="16,12"
                  Cursor="Hand"
                  PointerPressed="OnTabGameClick">
            <StackPanel Spacing="3">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="Gamepad"
                       Width="16" Height="16"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       VerticalAlignment="Center" />
                <TextBlock Text="游戏设置"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="实例、目录与内存"
                         FontSize="10"
                         Foreground="{DynamicResource HintTextBrush}" />
            </StackPanel>
          </Border>

          <!-- 工作区设置 -->
          <Border x:Name="TabWorkspace"
                  Background="{DynamicResource TransparentBrush}"
                  CornerRadius="8"
                  Margin="8,2"
                  Padding="16,12"
                  Cursor="Hand"
                  PointerPressed="OnTabWorkspaceClick">
            <StackPanel Spacing="3">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="Palette"
                       Width="16" Height="16"
                       Foreground="{DynamicResource SubtextTextBrush}"
                       VerticalAlignment="Center" />
                <TextBlock Text="工作区设置"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SubtextTextBrush}"
                           VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="布局、组件与个性化"
                         FontSize="10"
                         Foreground="{DynamicResource HintTextBrush}" />
            </StackPanel>
          </Border>

          <!-- 关于 -->
          <Border x:Name="TabAbout"
                  Background="{DynamicResource TransparentBrush}"
                  CornerRadius="8"
                  Margin="8,2"
                  Padding="16,12"
                  Cursor="Hand"
                  PointerPressed="OnTabAboutClick">
            <StackPanel Spacing="3">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="Information"
                       Width="16" Height="16"
                       Foreground="{DynamicResource SubtextTextBrush}"
                       VerticalAlignment="Center" />
                <TextBlock Text="关于"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SubtextTextBrush}"
                           VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="团队、依赖与项目信息"
                         FontSize="10"
                         Foreground="{DynamicResource HintTextBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- 右侧内容区 -->
      <Border Grid.Column="1"
              x:Name="ContentArea"
              Background="{DynamicResource WindowBgBrush}"
              Classes="nya-fade nya-shimmer">
        <Grid>
          <ContentControl x:Name="LegacySettingsHost" />
          <ContentControl x:Name="PersonalizationHost" IsVisible="False" />
          <ContentControl x:Name="AboutHost" IsVisible="False" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
