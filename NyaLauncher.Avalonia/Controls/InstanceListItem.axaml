<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NyaLauncher.Avalonia.Controls"
             xmlns:conv="using:NyaLauncher.Avalonia.Framework"
             x:Class="NyaLauncher.Avalonia.Controls.InstanceListItem"
             x:CompileBindings="False">
  <UserControl.Resources>
    <!-- 字形绑定转换器："material:Kind" 渲染为 Material 图标，其余回退文字 -->
    <conv:GlyphIconConverter x:Key="GlyphIcon" />
  </UserControl.Resources>
    <Grid ColumnDefinitions="38,9,*" Margin="5,6">
        <Border Width="38" Height="38" CornerRadius="7" Background="{DynamicResource BadgeBgBrush}" ClipToBounds="True">
      <Grid>
        <ContentControl Content="{Binding IconGlyph, Converter={StaticResource GlyphIcon}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
        <local:AsyncImage SourceUrl="{Binding IconPath}"
                          Width="38"
                          Height="38"
                          Stretch="Uniform" />
      </Grid>
    </Border>
    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
      <TextBlock Text="{Binding Name}"
                 FontSize="13"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding DirectoryMode}"
                 FontSize="10"
                 Foreground="{DynamicResource SubtextTextBrush}"
                 TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </Grid>
</UserControl>
