<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:NyaLauncher.Avalonia.Controls"
             xmlns:local="using:NyaLauncher.Avalonia.Controls"
             x:Class="NyaLauncher.Avalonia.Controls.ModDownloadOverlay">
  <Border Background="{DynamicResource BaseBgBrush}"
          CornerRadius="16"
          Width="790" MaxHeight="590"
          HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid RowDefinitions="Auto,*" ClipToBounds="True">

      <!-- 标题栏（共享组件） -->
      <controls:OverlayHeader x:Name="Header"
                              Grid.Row="0"
                              Margin="20,16"
                              CloseRequested="OnCloseClick" />

      <!-- 主体：左版本 / 右 loader -->
      <Grid Grid.Row="1" ColumnDefinitions="250,*">

        <!-- 左侧：MC 版本列表 -->
        <Border Grid.Column="0"
                Background="{DynamicResource PanelBgBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16"
                CornerRadius="0,0,0,16">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
            <TextBlock Text="Minecraft 版本"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBox x:Name="VersionFilterBox"
                     Grid.Row="1"
                     PlaceholderText="筛选版本…"
                     Background="{DynamicResource ControlBgBrush}"
                     BorderThickness="0"
                     CornerRadius="8"
                     Padding="10,6"
                     FontSize="12"
                     TextChanged="OnVersionFilterChanged" />
            <ListBox x:Name="GameVersionList"
                     Grid.Row="2"
                     Background="{DynamicResource TransparentBrush}"
                     BorderThickness="0"
                     SelectionChanged="OnGameVersionSelected">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="local:GameVersionEntry">
                  <Grid ColumnDefinitions="*,Auto" Margin="4,3">
                    <TextBlock Text="{Binding Version}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BodyTextBrush}" />
                    <Border Grid.Column="1"
                            Background="{DynamicResource BadgeBgBrush}"
                            CornerRadius="8"
                            Padding="7,2"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding LoaderCount}"
                                 FontSize="10"
                                 Foreground="{DynamicResource MutedTextBrush}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="VersionCountText"
                       Grid.Row="3"
                       FontSize="11"
                       Foreground="{DynamicResource HintTextBrush}" />
          </Grid>
        </Border>

        <!-- 右侧：Loader 版本 + 下载 -->
        <Border Grid.Column="1"
                Background="{DynamicResource BaseBgBrush}"
                Padding="20"
                CornerRadius="0,0,16,0">
          <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">

            <!-- Loader 过滤器 -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Text="加载器"
                         FontSize="12"
                         Foreground="{DynamicResource MutedTextBrush}"
                         VerticalAlignment="Center" />
              <ComboBox x:Name="LoaderFilterComboBox"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        MinWidth="150"
                        Background="{DynamicResource ControlBgBrush}"
                        BorderThickness="0"
                        CornerRadius="8"
                        Padding="10,5"
                        FontSize="12"
                        SelectionChanged="OnLoaderFilterChanged" />
            </Grid>

            <!-- 状态提示 -->
            <TextBlock x:Name="StatusText"
                       Grid.Row="1"
                       FontSize="12"
                       Foreground="{DynamicResource HintTextBrush}"
                       TextWrapping="Wrap" />

            <!-- 下载到（共享组件） -->
            <controls:DownloadTargetPicker x:Name="TargetPicker" Grid.Row="2" />

            <!-- Loader 卡片列表 -->
            <ScrollViewer Grid.Row="3" Margin="0,2,0,0">
              <StackPanel x:Name="LoaderListPanel" Spacing="10" />
            </ScrollViewer>

            <!-- 下载状态区（复用框架组件） -->
            <controls:DownloadStatusPanel x:Name="DownloadStatus"
                                          Grid.Row="4"
                                          Margin="0,6,0,0" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
