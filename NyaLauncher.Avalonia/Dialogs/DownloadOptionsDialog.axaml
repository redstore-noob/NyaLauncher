<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NyaLauncher.Avalonia.Dialogs.DownloadOptionsDialog"
        Title="下载选项"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{StaticResource BaseBgBrush}"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,Auto" Margin="28">

    <!-- 标题 -->
    <StackPanel Spacing="6">
      <TextBlock Text="下载 Minecraft"
                 FontSize="21"
                 FontWeight="Bold"
                 Foreground="{StaticResource PrimaryTextBrush}" />
      <TextBlock x:Name="VersionLabel"
                 FontSize="13"
                 Foreground="{StaticResource MutedTextBrush}" />
    </StackPanel>

    <!-- 选项区 -->
    <StackPanel Grid.Row="1" Spacing="16" Margin="0,20,0,0">

      <!-- Loader 类型选择 -->
      <StackPanel Spacing="6">
        <TextBlock Text="选择加载器"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource SecondaryTextBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <RadioButton x:Name="RadioVanilla"
                       Content="原版"
                       GroupName="Loader"
                       IsChecked="True"
                       IsCheckedChanged="OnLoaderTypeChanged"
                       Foreground="{StaticResource BodyTextBrush}"
                       FontSize="13" />
          <RadioButton x:Name="RadioFabric"
                       Content="Fabric"
                       GroupName="Loader"
                       IsCheckedChanged="OnLoaderTypeChanged"
                       Foreground="{StaticResource BodyTextBrush}"
                       FontSize="13" />
          <RadioButton x:Name="RadioNeoForge"
                       Content="NeoForge"
                       GroupName="Loader"
                       IsCheckedChanged="OnLoaderTypeChanged"
                       Foreground="{StaticResource BodyTextBrush}"
                       FontSize="13" />
          <RadioButton x:Name="RadioForge"
                       Content="Forge"
                       GroupName="Loader"
                       IsCheckedChanged="OnLoaderTypeChanged"
                       Foreground="{StaticResource BodyTextBrush}"
                       FontSize="13" />
        </StackPanel>
      </StackPanel>

      <!-- Loader 版本选择 -->
      <StackPanel x:Name="LoaderVersionSection" Spacing="6" IsVisible="False">
        <TextBlock Text="加载器版本"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource SecondaryTextBrush}" />
        <ComboBox x:Name="LoaderVersionComboBox"
                  PlaceholderText="选择加载器版本"
                  Background="{StaticResource ControlBgBrush}"
                  BorderThickness="0"
                  CornerRadius="8"
                  Padding="12,6"
                  HorizontalAlignment="Stretch"
                  FontSize="13"
                  SelectionChanged="OnLoaderVersionSelectionChanged" />
        <TextBlock x:Name="LoaderVersionHint"
                   FontSize="11"
                   Foreground="{StaticResource HintTextBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <!-- 自定义实例名 -->
      <StackPanel Spacing="6">
        <TextBlock Text="实例名称"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource SecondaryTextBrush}" />
        <TextBox x:Name="InstanceNameBox"
                 PlaceholderText="留空则使用默认名称"
                 Background="{StaticResource ControlBgBrush}"
                 BorderThickness="0"
                 CornerRadius="8"
                 Padding="12,8"
                 FontSize="13" />
        <TextBlock x:Name="InstanceNameHint"
                   FontSize="11"
                   Foreground="{StaticResource HintTextBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <!-- 状态提示 -->
      <TextBlock x:Name="StatusText"
                 FontSize="12"
                 Foreground="{StaticResource ErrorBrush}"
                 TextWrapping="Wrap"
                 IsVisible="False" />
    </StackPanel>

    <!-- 底部按钮 -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,20,0,0">
      <Button Grid.Column="1"
              Content="取消"
              Padding="18,8"
              CornerRadius="8"
              FontSize="13"
              Click="OnCancelClick" />
      <Button Grid.Column="2"
              x:Name="DownloadButton"
              Content="下载"
              Padding="24,8"
              CornerRadius="8"
              FontSize="13"
              FontWeight="SemiBold"
              Background="{StaticResource SystemAccentColor}"
              Foreground="{StaticResource WhiteBrush}"
              Click="OnDownloadClick" />
    </Grid>
  </Grid>
</Window>
