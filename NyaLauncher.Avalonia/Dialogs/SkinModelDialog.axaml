<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NyaLauncher.Avalonia.Dialogs.SkinModelDialog"
        Title="选择皮肤模型"
        Width="430"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{StaticResource BaseBgBrush}"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,Auto" Margin="26">
    <StackPanel Spacing="9">
      <TextBlock Text="选择手臂模型"
                 FontSize="21"
                 FontWeight="Bold"
                 Foreground="{StaticResource PrimaryTextBrush}" />
      <TextBlock Text="模型只决定手臂宽度，不会修改皮肤文件。"
                 FontSize="12"
                 Foreground="{StaticResource MutedTextBrush}" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,20">
      <Button Grid.Column="0"
              Padding="18,16"
              HorizontalContentAlignment="Left"
              Background="{StaticResource ButtonBgBrush}"
              BorderBrush="{StaticResource EmphasizedBorderBrush}"
              BorderThickness="1"
              Click="OnClassicClick">
        <StackPanel Spacing="5">
          <TextBlock Text="Steve · 粗手"
                     FontSize="15"
                     FontWeight="Bold" />
          <TextBlock Text="Classic / 4 像素手臂"
                     FontSize="11"
                     Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>
      </Button>
      <Button Grid.Column="1"
              Padding="18,16"
              HorizontalContentAlignment="Left"
              Background="{StaticResource ButtonBgBrush}"
              BorderBrush="{StaticResource EmphasizedBorderBrush}"
              BorderThickness="1"
              Click="OnSlimClick">
        <StackPanel Spacing="5">
          <TextBlock Text="Alex · 纤细"
                     FontSize="15"
                     FontWeight="Bold" />
          <TextBlock Text="Slim / 3 像素手臂"
                     FontSize="11"
                     Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>
      </Button>
    </Grid>

    <Button Grid.Row="2"
            Content="取消"
            Padding="16,8"
            HorizontalAlignment="Right"
            Click="OnCancelClick" />
  </Grid>
</Window>
