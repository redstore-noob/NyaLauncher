<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NyaLauncher.Avalonia.Windows.TaskDetailsWindow"
        Title="NyaLauncher 任务详情"
        Width="900"
        Height="570"
        MinWidth="720"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BaseBgBrush}">
  <Grid ColumnDefinitions="176,*">
    <Border Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource MediumBorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="14,20">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="5" Margin="8,0,8,20">
          <TextBlock Text="任务详情"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
          <TextBlock Text="下载与启动状态"
                     FontSize="10"
                     Foreground="{DynamicResource SubtextTextBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
          <Button x:Name="DownloadViewButton"
                  Content="下载进度"
                  Height="42"
                  HorizontalContentAlignment="Left"
                  Padding="14,0"
                  Background="{DynamicResource ButtonBgBrush}"
                  Foreground="{DynamicResource PrimaryTextBrush}"
                  CornerRadius="9"
                  Click="OnDownloadViewClick" />
          <Button x:Name="LaunchViewButton"
                  Content="启动日志"
                  Height="42"
                  HorizontalContentAlignment="Left"
                  Padding="14,0"
                  Background="{DynamicResource SurfaceBgBrush}"
                  Foreground="{DynamicResource BodyTextBrush}"
                  CornerRadius="9"
                  Click="OnLaunchViewClick" />
        </StackPanel>

        <Button Grid.Row="2"
                Content="关闭窗口"
                Padding="12,8"
                Background="{DynamicResource TransparentBrush}"
                BorderBrush="{DynamicResource StrongBorderBrush}"
                BorderThickness="1"
                Foreground="{DynamicResource SubtextTextBrush}"
                CornerRadius="8"
                Click="OnCloseClick" />
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="24">
      <Grid x:Name="DownloadView" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Spacing="5">
            <TextBlock x:Name="DownloadTitleText"
                       Text="Minecraft 下载进度"
                       FontSize="21"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock x:Name="DownloadDetailText"
                       Text="等待下载任务…"
                       FontSize="11"
                       Foreground="{DynamicResource SubtextTextBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Column="1"
                  Background="{DynamicResource ButtonBgBrush}"
                  BorderBrush="{DynamicResource EmphasizedBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="12,7"
                  VerticalAlignment="Center">
            <TextBlock x:Name="DownloadPhaseText"
                       Text="空闲"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentTextBrush}" />
          </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource PanelBgBrush}"
                BorderBrush="{DynamicResource StrongBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,14">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="总体下载进度"
                         FontSize="12"
                         Foreground="{DynamicResource BodyTextBrush}" />
              <TextBlock x:Name="DownloadPercentageText"
                         Grid.Column="1"
                         Text="0.0%"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentTextBrush}" />
            </Grid>
            <ProgressBar x:Name="DownloadProgressBar"
                         Height="9"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Foreground="{DynamicResource AccentDarkBrush}"
                         Background="{DynamicResource ControlBgBrush}" />
            <Grid ColumnDefinitions="*,*,*">
              <StackPanel Spacing="2">
                <TextBlock Text="下载速度" FontSize="9" Foreground="{DynamicResource DisabledTextBrush}" />
                <TextBlock x:Name="DownloadSpeedText" Text="正在测速" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="数据进度" FontSize="9" Foreground="{DynamicResource DisabledTextBrush}" />
                <TextBlock x:Name="DownloadBytesText" Text="0 B / 0 B" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="2">
                <TextBlock Text="文件进度" FontSize="9" Foreground="{DynamicResource DisabledTextBrush}" />
                <TextBlock x:Name="DownloadFilesText" Text="0 / 0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="安装阶段"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TertiaryTextBrush}"
                   Margin="2,0,0,8" />

        <Border Grid.Row="3"
                Background="{DynamicResource WindowBgBrush}"
                BorderBrush="{DynamicResource MediumBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
          <ScrollViewer>
            <ItemsControl x:Name="DownloadStagesList" />
          </ScrollViewer>
        </Border>

        <Button x:Name="CancelDownloadButton"
                Grid.Row="4"
                Content="取消下载"
                HorizontalAlignment="Right"
                Margin="0,14,0,0"
                Padding="18,8"
                Background="{DynamicResource ErrorDarkBrush}"
                BorderBrush="{DynamicResource ErrorBrush}"
                BorderThickness="1"
                Foreground="{DynamicResource PrimaryTextBrush}"
                CornerRadius="9"
                Click="OnCancelDownloadClick" />
      </Grid>

      <Grid x:Name="LaunchView" RowDefinitions="Auto,*,Auto" IsVisible="False">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Spacing="5">
            <TextBlock Text="Minecraft 启动日志"
                       FontSize="21"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock x:Name="LaunchLogStatusText"
                       Text="尚未启动游戏"
                       FontSize="11"
                       Foreground="{DynamicResource SubtextTextBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Column="1"
                  Background="{DynamicResource ButtonBgBrush}"
                  BorderBrush="{DynamicResource EmphasizedBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="12,7"
                  VerticalAlignment="Center">
            <TextBlock x:Name="LaunchLogPhaseText"
                       Text="空闲"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentTextBrush}" />
          </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource WindowBgBrush}"
                BorderBrush="{DynamicResource MediumBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">
          <TextBox x:Name="LaunchLogTextBox"
                   Text="等待启动任务…"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   FontFamily="Consolas"
                   FontSize="11"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Background="{DynamicResource TransparentBrush}"
                   BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Border>

        <TextBlock Grid.Row="2"
                   Text="启动日志仅保留本次启动最近 2000 行；打开后不会因游戏退出而自动关闭"
                   FontSize="10"
                   Foreground="{DynamicResource DisabledTextBrush}"
                   Margin="2,14,0,0" />
      </Grid>
    </Grid>
  </Grid>
</Window>
