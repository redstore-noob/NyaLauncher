<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NyaLauncher.Avalonia.OfflineSkinPickerDialog"
        Title="选择离线默认皮肤"
        Width="580"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        Background="#111522"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,Auto" Margin="26">
    <StackPanel Spacing="9">
      <TextBlock Text="选择离线默认皮肤"
                 FontSize="21"
                 FontWeight="Bold"
                 Foreground="#F6F7FF" />
      <TextBlock Text="离线账号无法使用 Mojang 皮肤；这里提供 9 款启动器内置的默认皮肤，"
                 FontSize="12"
                 Foreground="#A5AEC7"
                 TextWrapping="Wrap" />
      <TextBlock Text="已安装的 Minecraft 客户端会被优先复用其中的原始贴图，"
                 FontSize="12"
                 Foreground="#A5AEC7"
                 TextWrapping="Wrap" />
    </StackPanel>

    <WrapPanel x:Name="SkinPanel" Grid.Row="1" Margin="0,20,0,16" />

    <Button Grid.Row="2"
            Content="取消"
            Padding="16,8"
            HorizontalAlignment="Right"
            Click="OnCancelClick" />
  </Grid>
</Window>
