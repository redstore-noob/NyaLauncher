<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NyaLauncher.Avalonia.PersonalizationWindow"
             Background="#0D101A">

  <UserControl.Styles>
    <Style Selector="Button.Primary">
      <Setter Property="Background" Value="#6C7BFF" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#8D98FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="22,10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.Secondary">
      <Setter Property="Background" Value="#22283A" />
      <Setter Property="Foreground" Value="#C7CDE0" />
      <Setter Property="BorderBrush" Value="#343C52" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0"
            Padding="26,22"
            Background="#141827"
            BorderBrush="#293044"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto"
            RowDefinitions="Auto,Auto">
        <StackPanel Spacing="7">
          <TextBlock Text="个性化工作区"
                     FontSize="24"
                     FontWeight="Bold"
                     Foreground="#F6F7FF" />
          <TextBlock Text="自由编辑功能区名称与简介，并决定每个区域中出现哪些功能按钮。布局与大小会自动保存。"
                     FontSize="12"
                     Foreground="#8F98B3" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
          <Button Classes="Secondary"
                  Content="＋ 新建功能区"
                  Click="OnCreateAreaClick" />
          <Border Background="#252D47"
                  CornerRadius="12"
                  Padding="13,8"
                  VerticalAlignment="Center">
            <TextBlock Text="保存后应用"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#AEB6FF" />
          </Border>
        </StackPanel>

        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,18,0,0"
                Padding="14,11"
                Background="#1B2132"
                BorderBrush="#30384F"
                BorderThickness="1"
                CornerRadius="10">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                ColumnSpacing="10">
            <TextBlock Text="配置目录"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#C8CEFF"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="StorageDirectoryText"
                       Grid.Column="1"
                       FontFamily="Consolas"
                       FontSize="10"
                       Foreground="#8F98B3"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    Classes="Secondary"
                    Content="选择目录…"
                    Click="OnBrowseStorageDirectoryClick" />
            <Button Grid.Column="3"
                    Classes="Secondary"
                    Content="平台默认"
                    Click="OnUseDefaultStorageDirectoryClick" />
          </Grid>
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="AreaEditors"
                  Margin="24"
                  Spacing="16" />
    </ScrollViewer>

    <Border Grid.Row="2"
            Background="#121624"
            BorderBrush="#293044"
            BorderThickness="0,1,0,0"
            Padding="22,16">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
        <Button Classes="Secondary"
                Content="恢复默认"
                Click="OnResetClick" />
        <TextBlock Grid.Column="1"
                   Text="保存后立即刷新主界面"
                   FontSize="11"
                   Foreground="#6F7893"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Margin="0,0,10,0" />
        <Button Grid.Column="2"
                Classes="Secondary"
                Content="取消"
                Click="OnCancelClick" />
        <Button Grid.Column="3"
                Classes="Primary"
                Content="保存配置"
                Click="OnSaveClick" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
