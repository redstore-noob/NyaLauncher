<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">

    <!-- ===== Base Colors ===== -->
    <Color x:Key="TransparentColor">#00000000</Color>
    <Color x:Key="WhiteColor">#FFFFFF</Color>
    
    <!-- ===== Background Colors ===== -->
    <Color x:Key="WindowBgColor">#080E0B</Color>
    <Color x:Key="BaseBgColor">#0C1310</Color>
    <Color x:Key="CardBgColor">#0F1814</Color>
    <Color x:Key="PanelBgColor">#141F1A</Color>
    <Color x:Key="SurfaceBgColor">#192520</Color>
    <Color x:Key="HighlightBgColor">#1B2822</Color>
    <Color x:Key="ButtonBgColor">#1E2E27</Color>
    <Color x:Key="ControlBgColor">#21302A</Color>
    <Color x:Key="BadgeBgColor">#25342D</Color>
    
    <!-- ===== Border Colors ===== -->
    <Color x:Key="SubtleBorderColor">#1C2922</Color>
    <Color x:Key="DefaultBorderColor">#203028</Color>
    <Color x:Key="MediumBorderColor">#273830</Color>
    <Color x:Key="StrongBorderColor">#2C3E35</Color>
    <Color x:Key="EmphasizedBorderColor">#344A40</Color>
    
    <!-- ===== Text Colors ===== -->
    <Color x:Key="PrimaryTextColor">#F0F7F4</Color>
    <Color x:Key="SecondaryTextColor">#E0ECE6</Color>
    <Color x:Key="TertiaryTextColor">#D6E6DE</Color>
    <Color x:Key="LinkTextColor">#A8E0C8</Color>
    <Color x:Key="BodyTextColor">#BFD4C8</Color>
    <Color x:Key="AccentTextColor">#80D4B0</Color>
    <Color x:Key="MutedTextColor">#96B8A6</Color>
    <Color x:Key="SubtextTextColor">#7DA090</Color>
    <Color x:Key="HintTextColor">#668878</Color>
    <Color x:Key="DisabledTextColor">#5A7A6C</Color>
    <Color x:Key="PlaceholderTextColor">#4A6858</Color>
    
    <!-- ===== Accent Colors ===== -->
    <Color x:Key="AccentColor">#3EC9A0</Color>
    <Color x:Key="AccentDarkColor">#34B892</Color>
    <Color x:Key="AccentDarkerColor">#2CA482</Color>
    <Color x:Key="AccentLightColor">#5CDCBA</Color>
    <Color x:Key="AccentBrightColor">#60E2C0</Color>
    <Color x:Key="AccentDeepColor">#28A07A</Color>
    <Color x:Key="AccentDeepDarkColor">#1E8868</Color>
    
    <!-- ===== Semantic Colors ===== -->
    <Color x:Key="SuccessColor">#48D48A</Color>
    <Color x:Key="ErrorColor">#D94B64</Color>
    <Color x:Key="ErrorDarkColor">#B64A5A</Color>
    <Color x:Key="WarningColor">#D85B78</Color>
    <Color x:Key="InfoColor">#5EDCBA</Color>
    
    <!-- ===== Miku Theme Colors ===== -->
    <Color x:Key="MikuTeal">#30C0A0</Color>
    <Color x:Key="MikuPink">#E94196</Color>
    
    <!-- ===== Overlay Colors ===== -->
    <Color x:Key="DropPreviewBgColor">#3848D4A0</Color>
    <Color x:Key="DropPreviewBorderColor">#70D4B0</Color>
    <Color x:Key="DockHintBgColor">#E61A2B24</Color>
    <Color x:Key="SidebarDropPreviewBgColor">#403EC9A0</Color>
    <Color x:Key="SidebarDropPreviewBorderColor">#90E0C0</Color>
    <Color x:Key="OverlayBgColor">#C0000000</Color>
    <Color x:Key="DialogBgColor">#1E2E28</Color>
    <Color x:Key="DialogAltBgColor">#0E1612</Color>
    
    <!-- ===== Workspace Colors ===== -->
    <Color x:Key="CardBgColor2">#121C17</Color>
    <Color x:Key="HeaderBgColor">#192520</Color>
    <Color x:Key="CardBorderColor">#2A3E34</Color>
    <Color x:Key="SeamIdleColor">#2C3E35</Color>
    <Color x:Key="DragHandleBgColor">#223028</Color>
    <Color x:Key="DragHandleActiveColor">#345040</Color>
    <Color x:Key="DragHandleGlyphColor">#98C0AA</Color>
    <Color x:Key="IconBoxBgColor">#283830</Color>
    <Color x:Key="ComponentBgColor">#1B2822</Color>
    <Color x:Key="ComponentBorderColor">#2A3C34</Color>
    <Color x:Key="ComponentHoverBgColor">#243830</Color>
    <Color x:Key="ComponentPrimaryBgColor">#2CA482</Color>
    <Color x:Key="ComponentPrimaryBorderColor">#40C09A</Color>
    <Color x:Key="ComponentPrimaryHoverBgColor">#38B892</Color>
    <Color x:Key="SidebarBorderColor">#3A5048</Color>

    <!-- ===== Brushes ===== -->
    <SolidColorBrush x:Key="TransparentBrush" Color="{StaticResource TransparentColor}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}"/>
    
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}"/>
