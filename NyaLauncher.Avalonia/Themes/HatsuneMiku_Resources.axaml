        <Color x:Key="DockHintBgColor">#E6F0F7F4</Color>
        <Color x:Key="SidebarDropPreviewBgColor">#40E94196</Color>
        <Color x:Key="SidebarDropPreviewBorderColor">#F05AA8</Color>
        <Color x:Key="OverlayBgColor">#80000000</Color>
        <Color x:Key="DialogBgColor">#FFFFFF</Color>
        <Color x:Key="DialogAltBgColor">#F4FAF8</Color>
        
        <!-- ===== Workspace Colors ===== -->
        <Color x:Key="CardBgColor2">#F0F7F4</Color>
        <Color x:Key="HeaderBgColor">#E8F2ED</Color>
        <Color x:Key="CardBorderColor">#C8DDD2</Color>
        <Color x:Key="SeamIdleColor">#B8D0C4</Color>
        <Color x:Key="DragHandleBgColor">#E2EDE8</Color>
        <Color x:Key="DragHandleActiveColor">#39C5BB</Color>
        <Color x:Key="DragHandleGlyphColor">#4A6858</Color>
        <Color x:Key="IconBoxBgColor">#DCF0E8</Color>
        <Color x:Key="ComponentBgColor">#F8FCFA</Color>
        <Color x:Key="ComponentBorderColor">#C8DDD2</Color>
        <Color x:Key="ComponentHoverBgColor">#E8F2ED</Color>
        <Color x:Key="ComponentPrimaryBgColor">#E94196</Color>
        <Color x:Key="ComponentPrimaryBorderColor">#F05AA8</Color>
        <Color x:Key="ComponentPrimaryHoverBgColor">#F470B8</Color>
        <Color x:Key="SidebarBorderColor">#B8D0C4</Color>

