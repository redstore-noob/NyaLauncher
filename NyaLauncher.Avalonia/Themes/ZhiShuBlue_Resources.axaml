<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">

    <!-- ===== Base Colors ===== -->
    <Color x:Key="TransparentColor">#00000000</Color>
    <Color x:Key="WhiteColor">#FFFFFF</Color>
    
    <!-- ===== Background Colors (Klein Blue Dark) ===== -->
    <Color x:Key="WindowBgColor">#060A14</Color>
    <Color x:Key="BaseBgColor">#0A1020</Color>
    <Color x:Key="CardBgColor">#0E1528</Color>
    <Color x:Key="PanelBgColor">#121A30</Color>
    <Color x:Key="SurfaceBgColor">#162038</Color>
    <Color x:Key="HighlightBgColor">#1A2540</Color>
    <Color x:Key="ButtonBgColor">#1E2A48</Color>
    <Color x:Key="ControlBgColor">#223050</Color>
    <Color x:Key="BadgeBgColor">#263458</Color>
    
    <!-- ===== Border Colors ===== -->
    <Color x:Key="SubtleBorderColor">#1A2540</Color>
    <Color x:Key="DefaultBorderColor">#203050</Color>
    <Color x:Key="MediumBorderColor">#283860</Color>
    <Color x:Key="StrongBorderColor">#304070</Color>
    <Color x:Key="EmphasizedBorderColor">#384880</Color>
    
    <!-- ===== Text Colors ===== -->
    <Color x:Key="PrimaryTextColor">#E8EDF8</Color>
    <Color x:Key="SecondaryTextColor">#D8E0F0</Color>
    <Color x:Key="TertiaryTextColor">#C8D4E8</Color>
