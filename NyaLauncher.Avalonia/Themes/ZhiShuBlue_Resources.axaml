    <Color x:Key="MutedTextColor">#8098B8</Color>
    <Color x:Key="SubtextTextColor">#6880A0</Color>
    <Color x:Key="HintTextColor">#506888</Color>
    <Color x:Key="DisabledTextColor">#405068</Color>
    <Color x:Key="PlaceholderTextColor">#304060</Color>
    
    <!-- ===== Accent Colors (Klein Blue) ===== -->
    <Color x:Key="AccentColor">#002FA7</Color>
    <Color x:Key="AccentDarkColor">#002898</Color>
    <Color x:Key="AccentDarkerColor">#002088</Color>
    <Color x:Key="AccentLightColor">#1A4FC0</Color>
    <Color x:Key="AccentBrightColor">#3068D8</Color>
    <Color x:Key="AccentDeepColor">#001E80</Color>
    <Color x:Key="AccentDeepDarkColor">#001870</Color>
    
    <!-- ===== Semantic Colors ===== -->
    <Color x:Key="SuccessColor">#48D48A</Color>
    <Color x:Key="ErrorColor">#D94B64</Color>
    <Color x:Key="ErrorDarkColor">#B64A5A</Color>
    <Color x:Key="WarningColor">#D85B78</Color>
    <Color x:Key="InfoColor">#6090D0</Color>
    
    <!-- ===== Theme-Specific Colors ===== -->
    <Color x:Key="ZhiShuBlue">#002FA7</Color>
    <Color x:Key="ZhiShuBlueLight">#1A4FC0</Color>
    
    <!-- ===== Overlay Colors ===== -->
    <Color x:Key="DropPreviewBgColor">#38002FA7</Color>
    <Color x:Key="DropPreviewBorderColor">#6090D0</Color>
    <Color x:Key="DockHintBgColor">#E60A1020</Color>
    <Color x:Key="SidebarDropPreviewBgColor">#40002FA7</Color>
    <Color x:Key="SidebarDropPreviewBorderColor">#80A8E0</Color>
    <Color x:Key="OverlayBgColor">#C0000000</Color>
    <Color x:Key="DialogBgColor">#1A2540</Color>
    <Color x:Key="DialogAltBgColor">#0A0F1C</Color>
    
    <!-- ===== Workspace Colors ===== -->
    <Color x:Key="CardBgColor2">#0C1220</Color>
    <Color x:Key="HeaderBgColor">#162038</Color>
    <Color x:Key="CardBorderColor">#283860</Color>
    <Color x:Key="SeamIdleColor">#304070</Color>
    <Color x:Key="DragHandleBgColor">#1E2A48</Color>
    <Color x:Key="DragHandleActiveColor">#002FA7</Color>
    <Color x:Key="DragHandleGlyphColor">#8098B8</Color>
    <Color x:Key="IconBoxBgColor">#223050</Color>
    <Color x:Key="ComponentBgColor">#1A2540</Color>
    <Color x:Key="ComponentBorderColor">#283860</Color>
    <Color x:Key="ComponentHoverBgColor">#202E50</Color>
    <Color x:Key="ComponentPrimaryBgColor">#002FA7</Color>
    <Color x:Key="ComponentPrimaryBorderColor">#1A4FC0</Color>
    <Color x:Key="ComponentPrimaryHoverBgColor">#0038C0</Color>
    <Color x:Key="SidebarBorderColor">#304070</Color>

