    <Color x:Key="SystemAccentColor">#002FA7</Color>
    <Color x:Key="SystemAccentColorDark1">#002898</Color>
    <Color x:Key="SystemAccentColorDark2">#002088</Color>
    <Color x:Key="SystemAccentColorLight1">#1A4FC0</Color>

