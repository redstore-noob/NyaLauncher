<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
    主题家族：Codex蓝，沿用 newgui 时期的冷蓝配色。
    直接键 = 默认强调色阶梯 / Material 次色 / 语义色；
    ThemeDictionaries = 深浅背景搭配；浅色同时采用原主题较深的蓝色强调色，
    由 StyleAlter 叠加在 BasePalette.axaml 中性基底之上（必须成对写出两种模式）。
    -->
    <!-- ===== 强调色阶梯 ===== -->
    <Color x:Key="AccentColor">#7C8CFF</Color>
    <Color x:Key="AccentDarkColor">#6C7BFF</Color>
    <Color x:Key="AccentDarkerColor">#5968E8</Color>
    <Color x:Key="AccentLightColor">#8D98FF</Color>
    <Color x:Key="AccentBrightColor">#AAB3FF</Color>
    <Color x:Key="AccentDeepColor">#5868EA</Color>
    <Color x:Key="AccentDeepDarkColor">#4050C8</Color>

    <!-- ===== Material 次色（家族特色色） ===== -->
    <Color x:Key="SecondaryAccentColor">#AEB6FF</Color>

    <!-- ===== 默认语义色 ===== -->
    <Color x:Key="SuccessColor">#62D49A</Color>
    <Color x:Key="ErrorColor">#D94B64</Color>
    <Color x:Key="ErrorDarkColor">#B64A5A</Color>
    <Color x:Key="WarningColor">#D85B78</Color>
    <Color x:Key="InfoColor">#AEB6FF</Color>

    <!-- ===== Brushes（强调 / 语义） ===== -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
    <SolidColorBrush x:Key="AccentDarkerBrush" Color="{StaticResource AccentDarkerColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource AccentBrightColor}"/>
    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}"/>
    <SolidColorBrush x:Key="AccentDeepDarkBrush" Color="{StaticResource AccentDeepDarkColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorDarkBrush" Color="{StaticResource ErrorDarkColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- ===== 暗色背景搭配（冷蓝暗底） ===== -->
            <Color x:Key="WindowBgColor">#0D101A</Color>
            <Color x:Key="BaseBgColor">#121624</Color>
            <Color x:Key="CardBgColor">#141827</Color>
            <Color x:Key="PanelBgColor">#171B2B</Color>
            <Color x:Key="SurfaceBgColor">#20263A</Color>
            <Color x:Key="HighlightBgColor">#252D47</Color>
            <Color x:Key="ButtonBgColor">#22283A</Color>
            <Color x:Key="ControlBgColor">#2A3042</Color>
            <Color x:Key="BadgeBgColor">#303958</Color>

            <Color x:Key="SubtleBorderColor">#252B3D</Color>
            <Color x:Key="DefaultBorderColor">#293044</Color>
            <Color x:Key="MediumBorderColor">#30384F</Color>
            <Color x:Key="StrongBorderColor">#343C52</Color>
            <Color x:Key="EmphasizedBorderColor">#3A4563</Color>

            <Color x:Key="PrimaryTextColor">#F6F7FF</Color>
            <Color x:Key="SecondaryTextColor">#E3E6F3</Color>
            <Color x:Key="TertiaryTextColor">#C7CDE0</Color>
            <Color x:Key="BodyTextColor">#CBD1E6</Color>
            <Color x:Key="MutedTextColor">#A5AEC7</Color>
            <Color x:Key="SubtextTextColor">#8F98B3</Color>
            <Color x:Key="HintTextColor">#77809B</Color>
            <Color x:Key="DisabledTextColor">#6F7893</Color>
            <Color x:Key="PlaceholderTextColor">#59627C</Color>

            <Color x:Key="DockHintBgColor">#E62C334B</Color>
            <Color x:Key="OverlayBgColor">#C0000000</Color>
            <Color x:Key="DialogBgColor">#111522</Color>
            <Color x:Key="DialogAltBgColor">#0C101B</Color>

            <Color x:Key="CardBgColor2">#171B2B</Color>
            <Color x:Key="HeaderBgColor">#20263A</Color>
            <Color x:Key="CardBorderColor">#30374D</Color>
            <Color x:Key="SeamIdleColor">#343C52</Color>
            <Color x:Key="DragHandleBgColor">#2B3248</Color>
            <Color x:Key="DragHandleGlyphColor">#AAB2CC</Color>
            <Color x:Key="IconBoxBgColor">#303958</Color>
            <Color x:Key="ComponentBgColor">#22283A</Color>
            <Color x:Key="ComponentBorderColor">#3A4563</Color>
            <Color x:Key="ComponentHoverBgColor">#2D354D</Color>
            <Color x:Key="SidebarBorderColor">#46506A</Color>

            <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}"/>
            <SolidColorBrush x:Key="BaseBgBrush" Color="{StaticResource BaseBgColor}"/>
            <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}"/>
            <SolidColorBrush x:Key="PanelBgBrush" Color="{StaticResource PanelBgColor}"/>
            <SolidColorBrush x:Key="SurfaceBgBrush" Color="{StaticResource SurfaceBgColor}"/>
            <SolidColorBrush x:Key="HighlightBgBrush" Color="{StaticResource HighlightBgColor}"/>
            <SolidColorBrush x:Key="ButtonBgBrush" Color="{StaticResource ButtonBgColor}"/>
            <SolidColorBrush x:Key="ControlBgBrush" Color="{StaticResource ControlBgColor}"/>
            <SolidColorBrush x:Key="BadgeBgBrush" Color="{StaticResource BadgeBgColor}"/>

            <SolidColorBrush x:Key="SubtleBorderBrush" Color="{StaticResource SubtleBorderColor}"/>
            <SolidColorBrush x:Key="DefaultBorderBrush" Color="{StaticResource DefaultBorderColor}"/>
            <SolidColorBrush x:Key="MediumBorderBrush" Color="{StaticResource MediumBorderColor}"/>
            <SolidColorBrush x:Key="StrongBorderBrush" Color="{StaticResource StrongBorderColor}"/>
            <SolidColorBrush x:Key="EmphasizedBorderBrush" Color="{StaticResource EmphasizedBorderColor}"/>

            <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="{StaticResource TertiaryTextColor}"/>
            <SolidColorBrush x:Key="BodyTextBrush" Color="{StaticResource BodyTextColor}"/>
            <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
            <SolidColorBrush x:Key="SubtextTextBrush" Color="{StaticResource SubtextTextColor}"/>
            <SolidColorBrush x:Key="HintTextBrush" Color="{StaticResource HintTextColor}"/>
            <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}"/>
            <SolidColorBrush x:Key="PlaceholderTextBrush" Color="{StaticResource PlaceholderTextColor}"/>

            <SolidColorBrush x:Key="DockHintBgBrush" Color="{StaticResource DockHintBgColor}"/>
            <SolidColorBrush x:Key="OverlayBgBrush" Color="{StaticResource OverlayBgColor}"/>
            <SolidColorBrush x:Key="DialogBgBrush" Color="{StaticResource DialogBgColor}"/>
            <SolidColorBrush x:Key="DialogAltBgBrush" Color="{StaticResource DialogAltBgColor}"/>

            <SolidColorBrush x:Key="CardBg2Brush" Color="{StaticResource CardBgColor2}"/>
            <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBgColor}"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>
            <SolidColorBrush x:Key="SeamIdleBrush" Color="{StaticResource SeamIdleColor}"/>
            <SolidColorBrush x:Key="DragHandleBgBrush" Color="{StaticResource DragHandleBgColor}"/>
            <SolidColorBrush x:Key="DragHandleGlyphBrush" Color="{StaticResource DragHandleGlyphColor}"/>
            <SolidColorBrush x:Key="IconBoxBgBrush" Color="{StaticResource IconBoxBgColor}"/>
            <SolidColorBrush x:Key="ComponentBgBrush" Color="{StaticResource ComponentBgColor}"/>
            <SolidColorBrush x:Key="ComponentBorderBrush" Color="{StaticResource ComponentBorderColor}"/>
            <SolidColorBrush x:Key="ComponentHoverBgBrush" Color="{StaticResource ComponentHoverBgColor}"/>
            <SolidColorBrush x:Key="SidebarBorderBrush" Color="{StaticResource SidebarBorderColor}"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- 浅色强调与语义色沿用原 Codex蓝亮色模式，避免亮底上的蓝色过浅。 -->
            <Color x:Key="AccentColor">#5968E8</Color>
            <Color x:Key="AccentDarkColor">#4B59D8</Color>
            <Color x:Key="AccentDarkerColor">#5260DF</Color>
            <Color x:Key="AccentLightColor">#6C7BFF</Color>
            <Color x:Key="AccentBrightColor">#8D98FF</Color>
            <Color x:Key="AccentDeepColor">#4050C8</Color>
            <Color x:Key="AccentDeepDarkColor">#3643B8</Color>
            <Color x:Key="SecondaryAccentColor">#7C8CFF</Color>
            <Color x:Key="SuccessColor">#2E8B57</Color>
            <Color x:Key="InfoColor">#5968E8</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
            <SolidColorBrush x:Key="AccentDarkerBrush" Color="{StaticResource AccentDarkerColor}"/>
            <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
            <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource AccentBrightColor}"/>
            <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}"/>
            <SolidColorBrush x:Key="AccentDeepDarkBrush" Color="{StaticResource AccentDeepDarkColor}"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
            <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

            <!-- ===== 浅色背景搭配（冷白与淡蓝灰） ===== -->
            <Color x:Key="WindowBgColor">#F7F8FF</Color>
            <Color x:Key="BaseBgColor">#F0F2FC</Color>
            <Color x:Key="CardBgColor">#FFFFFF</Color>
            <Color x:Key="PanelBgColor">#F5F6FC</Color>
            <Color x:Key="SurfaceBgColor">#ECEEFA</Color>
            <Color x:Key="HighlightBgColor">#E4E7F7</Color>
            <Color x:Key="ButtonBgColor">#E0E3F2</Color>
            <Color x:Key="ControlBgColor">#FFFFFF</Color>
            <Color x:Key="BadgeBgColor">#D9DDF0</Color>

            <Color x:Key="SubtleBorderColor">#D9DDEC</Color>
            <Color x:Key="DefaultBorderColor">#CED3E6</Color>
            <Color x:Key="MediumBorderColor">#C1C7DE</Color>
            <Color x:Key="StrongBorderColor">#B3BAD5</Color>
            <Color x:Key="EmphasizedBorderColor">#A4ADD0</Color>

            <Color x:Key="PrimaryTextColor">#161925</Color>
            <Color x:Key="SecondaryTextColor">#222638</Color>
            <Color x:Key="TertiaryTextColor">#30354A</Color>
            <Color x:Key="BodyTextColor">#343A50</Color>
            <Color x:Key="MutedTextColor">#59627C</Color>
            <Color x:Key="SubtextTextColor">#6F7893</Color>
            <Color x:Key="HintTextColor">#77809B</Color>
            <Color x:Key="DisabledTextColor">#9DA6BF</Color>
            <Color x:Key="PlaceholderTextColor">#AAB2C9</Color>

            <Color x:Key="DockHintBgColor">#E6F0F2FC</Color>
            <Color x:Key="OverlayBgColor">#80000000</Color>
            <Color x:Key="DialogBgColor">#FFFFFF</Color>
            <Color x:Key="DialogAltBgColor">#F7F8FF</Color>

            <Color x:Key="CardBgColor2">#ECEEFA</Color>
            <Color x:Key="HeaderBgColor">#E4E7F7</Color>
            <Color x:Key="CardBorderColor">#CED3E6</Color>
            <Color x:Key="SeamIdleColor">#C1C7DE</Color>
            <Color x:Key="DragHandleBgColor">#E0E3F2</Color>
            <Color x:Key="DragHandleGlyphColor">#59627C</Color>
            <Color x:Key="IconBoxBgColor">#D9DDF0</Color>
            <Color x:Key="ComponentBgColor">#F5F6FC</Color>
            <Color x:Key="ComponentBorderColor">#CED3E6</Color>
            <Color x:Key="ComponentHoverBgColor">#E4E7F7</Color>
            <Color x:Key="SidebarBorderColor">#C1C7DE</Color>

            <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}"/>
            <SolidColorBrush x:Key="BaseBgBrush" Color="{StaticResource BaseBgColor}"/>
            <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}"/>
            <SolidColorBrush x:Key="PanelBgBrush" Color="{StaticResource PanelBgColor}"/>
            <SolidColorBrush x:Key="SurfaceBgBrush" Color="{StaticResource SurfaceBgColor}"/>
            <SolidColorBrush x:Key="HighlightBgBrush" Color="{StaticResource HighlightBgColor}"/>
            <SolidColorBrush x:Key="ButtonBgBrush" Color="{StaticResource ButtonBgColor}"/>
            <SolidColorBrush x:Key="ControlBgBrush" Color="{StaticResource ControlBgColor}"/>
            <SolidColorBrush x:Key="BadgeBgBrush" Color="{StaticResource BadgeBgColor}"/>

            <SolidColorBrush x:Key="SubtleBorderBrush" Color="{StaticResource SubtleBorderColor}"/>
            <SolidColorBrush x:Key="DefaultBorderBrush" Color="{StaticResource DefaultBorderColor}"/>
            <SolidColorBrush x:Key="MediumBorderBrush" Color="{StaticResource MediumBorderColor}"/>
            <SolidColorBrush x:Key="StrongBorderBrush" Color="{StaticResource StrongBorderColor}"/>
            <SolidColorBrush x:Key="EmphasizedBorderBrush" Color="{StaticResource EmphasizedBorderColor}"/>

            <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="{StaticResource TertiaryTextColor}"/>
            <SolidColorBrush x:Key="BodyTextBrush" Color="{StaticResource BodyTextColor}"/>
            <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
            <SolidColorBrush x:Key="SubtextTextBrush" Color="{StaticResource SubtextTextColor}"/>
            <SolidColorBrush x:Key="HintTextBrush" Color="{StaticResource HintTextColor}"/>
            <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}"/>
            <SolidColorBrush x:Key="PlaceholderTextBrush" Color="{StaticResource PlaceholderTextColor}"/>

            <SolidColorBrush x:Key="DockHintBgBrush" Color="{StaticResource DockHintBgColor}"/>
            <SolidColorBrush x:Key="OverlayBgBrush" Color="{StaticResource OverlayBgColor}"/>
            <SolidColorBrush x:Key="DialogBgBrush" Color="{StaticResource DialogBgColor}"/>
            <SolidColorBrush x:Key="DialogAltBgBrush" Color="{StaticResource DialogAltBgColor}"/>

            <SolidColorBrush x:Key="CardBg2Brush" Color="{StaticResource CardBgColor2}"/>
            <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBgColor}"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>
            <SolidColorBrush x:Key="SeamIdleBrush" Color="{StaticResource SeamIdleColor}"/>
            <SolidColorBrush x:Key="DragHandleBgBrush" Color="{StaticResource DragHandleBgColor}"/>
            <SolidColorBrush x:Key="DragHandleGlyphBrush" Color="{StaticResource DragHandleGlyphColor}"/>
            <SolidColorBrush x:Key="IconBoxBgBrush" Color="{StaticResource IconBoxBgColor}"/>
            <SolidColorBrush x:Key="ComponentBgBrush" Color="{StaticResource ComponentBgColor}"/>
            <SolidColorBrush x:Key="ComponentBorderBrush" Color="{StaticResource ComponentBorderColor}"/>
            <SolidColorBrush x:Key="ComponentHoverBgBrush" Color="{StaticResource ComponentHoverBgColor}"/>
            <SolidColorBrush x:Key="SidebarBorderBrush" Color="{StaticResource SidebarBorderColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
