<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Spacing="10">
                <TextBlock Text="Hatsune Miku Light Theme" FontSize="24" FontWeight="Bold"/>
                <Button Content="Primary Button" />
                <TextBox Watermark="Enter text..."/>
                <CheckBox Content="CheckBox"/>
                <RadioButton Content="RadioButton"/>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <!-- ===== Base Colors ===== -->
        <Color x:Key="TransparentColor">#00000000</Color>
        <Color x:Key="WhiteColor">#FFFFFF</Color>
        
        <!-- ===== Background Colors (Light) ===== -->
        <Color x:Key="WindowBgColor">#F4FAF8</Color>
        <Color x:Key="BaseBgColor">#EEF6F3</Color>
        <Color x:Key="CardBgColor">#FFFFFF</Color>
        <Color x:Key="PanelBgColor">#F8FCFA</Color>
        <Color x:Key="SurfaceBgColor">#F0F7F4</Color>
        <Color x:Key="HighlightBgColor">#E8F2ED</Color>
        <Color x:Key="ButtonBgColor">#E2EDE8</Color>
        <Color x:Key="ControlBgColor">#FFFFFF</Color>
        <Color x:Key="BadgeBgColor">#DCF0E8</Color>
        
        <!-- ===== Border Colors ===== -->
        <Color x:Key="SubtleBorderColor">#D8E8E0</Color>
        <Color x:Key="DefaultBorderColor">#C8DDD2</Color>
        <Color x:Key="MediumBorderColor">#B8D0C4</Color>
        <Color x:Key="StrongBorderColor">#A8C0B4</Color>
        <Color x:Key="EmphasizedBorderColor">#90B0A0</Color>
        
        <!-- ===== Text Colors ===== -->
        <Color x:Key="PrimaryTextColor">#000000</Color>
        <Color x:Key="SecondaryTextColor">#0A0A0A</Color>
        <Color x:Key="TertiaryTextColor">#1A1A1A</Color>
        <Color x:Key="LinkTextColor">#006040</Color>
        <Color x:Key="BodyTextColor">#1A1A1A</Color>
        <Color x:Key="AccentTextColor">#A02060</Color>
        <Color x:Key="MutedTextColor">#333333</Color>
        <Color x:Key="SubtextTextColor">#444444</Color>
        <Color x:Key="HintTextColor">#555555</Color>
        <Color x:Key="DisabledTextColor">#888888</Color>
        <Color x:Key="PlaceholderTextColor">#999999</Color>
        
        <!-- ===== Accent Colors (Miku Pink!) ===== -->
        <Color x:Key="AccentColor">#E94196</Color>
        <Color x:Key="AccentDarkColor">#D63A87</Color>
        <Color x:Key="AccentDarkerColor">#C03078</Color>
        <Color x:Key="AccentLightColor">#F05AA8</Color>
        <Color x:Key="AccentBrightColor">#F470B8</Color>
        <Color x:Key="AccentDeepColor">#C03078</Color>
        <Color x:Key="AccentDeepDarkColor">#A82868</Color>
        
        <!-- ===== Semantic Colors ===== -->
        <Color x:Key="SuccessColor">#2E8B57</Color>
        <Color x:Key="ErrorColor">#D94B64</Color>
        <Color x:Key="ErrorDarkColor">#B64A5A</Color>
        <Color x:Key="WarningColor">#D85B78</Color>
        <Color x:Key="InfoColor">#39C5BB</Color>
        
        <!-- ===== Miku Theme Colors ===== -->
        <Color x:Key="MikuTeal">#39C5BB</Color>
        <Color x:Key="MikuPink">#E94196</Color>
        
        <!-- ===== Overlay Colors ===== -->
        <Color x:Key="DropPreviewBgColor">#38E94196</Color>
        <Color x:Key="DropPreviewBorderColor">#E94196</Color>
        <Color x:Key="DockHintBgColor">#E6F0F7F4</Color>
        <Color x:Key="SidebarDropPreviewBgColor">#40E94196</Color>
        <Color x:Key="SidebarDropPreviewBorderColor">#F05AA8</Color>
        <Color x:Key="OverlayBgColor">#80000000</Color>
        <Color x:Key="DialogBgColor">#FFFFFF</Color>
        <Color x:Key="DialogAltBgColor">#F4FAF8</Color>
        
        <!-- ===== Workspace Colors ===== -->
        <Color x:Key="CardBgColor2">#F0F7F4</Color>
        <Color x:Key="HeaderBgColor">#E8F2ED</Color>
        <Color x:Key="CardBorderColor">#C8DDD2</Color>
        <Color x:Key="SeamIdleColor">#B8D0C4</Color>
        <Color x:Key="DragHandleBgColor">#E2EDE8</Color>
        <Color x:Key="DragHandleActiveColor">#39C5BB</Color>
        <Color x:Key="DragHandleGlyphColor">#4A6858</Color>
        <Color x:Key="IconBoxBgColor">#DCF0E8</Color>
        <Color x:Key="ComponentBgColor">#F8FCFA</Color>
        <Color x:Key="ComponentBorderColor">#C8DDD2</Color>
        <Color x:Key="ComponentHoverBgColor">#E8F2ED</Color>
        <Color x:Key="ComponentPrimaryBgColor">#E94196</Color>
        <Color x:Key="ComponentPrimaryBorderColor">#F05AA8</Color>
        <Color x:Key="ComponentPrimaryHoverBgColor">#F470B8</Color>
        <Color x:Key="SidebarBorderColor">#B8D0C4</Color>

        <!-- ===== Brushes ===== -->
        <SolidColorBrush x:Key="TransparentBrush" Color="{StaticResource TransparentColor}"/>
        <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}"/>
        
        <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}"/>
        <SolidColorBrush x:Key="BaseBgBrush" Color="{StaticResource BaseBgColor}"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}"/>
        <SolidColorBrush x:Key="PanelBgBrush" Color="{StaticResource PanelBgColor}"/>
        <SolidColorBrush x:Key="SurfaceBgBrush" Color="{StaticResource SurfaceBgColor}"/>
        <SolidColorBrush x:Key="HighlightBgBrush" Color="{StaticResource HighlightBgColor}"/>
        <SolidColorBrush x:Key="ButtonBgBrush" Color="{StaticResource ButtonBgColor}"/>
        <SolidColorBrush x:Key="ControlBgBrush" Color="{StaticResource ControlBgColor}"/>
        <SolidColorBrush x:Key="BadgeBgBrush" Color="{StaticResource BadgeBgColor}"/>
        
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="{StaticResource SubtleBorderColor}"/>
        <SolidColorBrush x:Key="DefaultBorderBrush" Color="{StaticResource DefaultBorderColor}"/>
        <SolidColorBrush x:Key="MediumBorderBrush" Color="{StaticResource MediumBorderColor}"/>
        <SolidColorBrush x:Key="StrongBorderBrush" Color="{StaticResource StrongBorderColor}"/>
        <SolidColorBrush x:Key="EmphasizedBorderBrush" Color="{StaticResource EmphasizedBorderColor}"/>
        
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
        <SolidColorBrush x:Key="TertiaryTextBrush" Color="{StaticResource TertiaryTextColor}"/>
        <SolidColorBrush x:Key="LinkTextBrush" Color="{StaticResource LinkTextColor}"/>
        <SolidColorBrush x:Key="BodyTextBrush" Color="{StaticResource BodyTextColor}"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
        <SolidColorBrush x:Key="SubtextTextBrush" Color="{StaticResource SubtextTextColor}"/>
        <SolidColorBrush x:Key="HintTextBrush" Color="{StaticResource HintTextColor}"/>
        <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}"/>
        <SolidColorBrush x:Key="PlaceholderTextBrush" Color="{StaticResource PlaceholderTextColor}"/>
        
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
        <SolidColorBrush x:Key="AccentDarkerBrush" Color="{StaticResource AccentDarkerColor}"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
        <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource AccentBrightColor}"/>
        <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}"/>
        <SolidColorBrush x:Key="AccentDeepDarkBrush" Color="{StaticResource AccentDeepDarkColor}"/>
        
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
        <SolidColorBrush x:Key="ErrorDarkBrush" Color="{StaticResource ErrorDarkColor}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
        <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
        
        <SolidColorBrush x:Key="MikuTealBrush" Color="{StaticResource MikuTeal}"/>
        <SolidColorBrush x:Key="MikuPinkBrush" Color="{StaticResource MikuPink}"/>
        
        <SolidColorBrush x:Key="DropPreviewBgBrush" Color="{StaticResource DropPreviewBgColor}"/>
        <SolidColorBrush x:Key="DropPreviewBorderBrush" Color="{StaticResource DropPreviewBorderColor}"/>
        <SolidColorBrush x:Key="DockHintBgBrush" Color="{StaticResource DockHintBgColor}"/>
        <SolidColorBrush x:Key="SidebarDropPreviewBgBrush" Color="{StaticResource SidebarDropPreviewBgColor}"/>
        <SolidColorBrush x:Key="SidebarDropPreviewBorderBrush" Color="{StaticResource SidebarDropPreviewBorderColor}"/>
        <SolidColorBrush x:Key="OverlayBgBrush" Color="{StaticResource OverlayBgColor}"/>
        <SolidColorBrush x:Key="DialogBgBrush" Color="{StaticResource DialogBgColor}"/>
        <SolidColorBrush x:Key="DialogAltBgBrush" Color="{StaticResource DialogAltBgColor}"/>
        
        <SolidColorBrush x:Key="CardBg2Brush" Color="{StaticResource CardBgColor2}"/>
        <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBgColor}"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>
        <SolidColorBrush x:Key="SeamIdleBrush" Color="{StaticResource SeamIdleColor}"/>
        <SolidColorBrush x:Key="DragHandleBgBrush" Color="{StaticResource DragHandleBgColor}"/>
        <SolidColorBrush x:Key="DragHandleActiveBrush" Color="{StaticResource DragHandleActiveColor}"/>
        <SolidColorBrush x:Key="DragHandleGlyphBrush" Color="{StaticResource DragHandleGlyphColor}"/>
        <SolidColorBrush x:Key="IconBoxBgBrush" Color="{StaticResource IconBoxBgColor}"/>
        <SolidColorBrush x:Key="ComponentBgBrush" Color="{StaticResource ComponentBgColor}"/>
        <SolidColorBrush x:Key="ComponentBorderBrush" Color="{StaticResource ComponentBorderColor}"/>
        <SolidColorBrush x:Key="ComponentHoverBgBrush" Color="{StaticResource ComponentHoverBgColor}"/>
        <SolidColorBrush x:Key="ComponentPrimaryBgBrush" Color="{StaticResource ComponentPrimaryBgColor}"/>
        <SolidColorBrush x:Key="ComponentPrimaryBorderBrush" Color="{StaticResource ComponentPrimaryBorderColor}"/>
        <SolidColorBrush x:Key="ComponentPrimaryHoverBgBrush" Color="{StaticResource ComponentPrimaryHoverBgColor}"/>
        <SolidColorBrush x:Key="SidebarBorderBrush" Color="{StaticResource SidebarBorderColor}"/>

        <!-- ===== Polygon Component Brushes ===== -->
        <SolidColorBrush x:Key="PolygonComponentCardBgBrush" Color="{StaticResource PolygonComponentCardBg}"/>
        <SolidColorBrush x:Key="PolygonComponentCardBorderBrush" Color="{StaticResource PolygonComponentCardBorder}"/>
        <SolidColorBrush x:Key="PolygonIconBoxBgBrush" Color="{StaticResource PolygonIconBoxBg}"/>
        <SolidColorBrush x:Key="PolygonDragGlyphBrush" Color="{StaticResource PolygonDragGlyph}"/>
        <SolidColorBrush x:Key="PolygonEditorSurfaceBrush" Color="{StaticResource PolygonEditorSurface}"/>
        <SolidColorBrush x:Key="PolygonEditorBorderBrush" Color="{StaticResource PolygonEditorBorder}"/>
        <SolidColorBrush x:Key="PolygonCardBgBrush" Color="{StaticResource PolygonCardBg}"/>
        <SolidColorBrush x:Key="PolygonCardBorderBrush" Color="{StaticResource PolygonCardBorder}"/>
        <SolidColorBrush x:Key="PolygonDeleteBgBrush" Color="{StaticResource PolygonDeleteBg}"/>
        <SolidColorBrush x:Key="PolygonDeleteBorderBrush" Color="{StaticResource PolygonDeleteBorder}"/>
        <SolidColorBrush x:Key="PolygonDeleteFgBrush" Color="{StaticResource PolygonDeleteFg}"/>
        <SolidColorBrush x:Key="PolygonPresetBgBrush" Color="{StaticResource PolygonPresetBg}"/>
        <SolidColorBrush x:Key="PolygonPresetBorderBrush" Color="{StaticResource PolygonPresetBorder}"/>
        <SolidColorBrush x:Key="PolygonSkinButtonBgBrush" Color="{StaticResource PolygonSkinButtonBg}"/>
        <SolidColorBrush x:Key="PolygonSkinButtonBgCurrentBrush" Color="{StaticResource PolygonSkinButtonBgCurrent}"/>
        <SolidColorBrush x:Key="PolygonSkinButtonBorderBrush" Color="{StaticResource PolygonSkinButtonBorder}"/>
        <SolidColorBrush x:Key="PolygonSkinButtonBorderCurrentBrush" Color="{StaticResource PolygonSkinButtonBorderCurrent}"/>
        <SolidColorBrush x:Key="PolygonSkinAvatarBgBrush" Color="{StaticResource PolygonSkinAvatarBg}"/>
        <SolidColorBrush x:Key="PolygonDisabledTextBrush" Color="{StaticResource PolygonDisabledText}"/>
        <SolidColorBrush x:Key="PolygonDragPreviewBgBrush" Color="{StaticResource PolygonDragPreviewBg}"/>
        <SolidColorBrush x:Key="PolygonTaskDownloadingBgBrush" Color="{StaticResource PolygonTaskActivityDownloadingBg}"/>
        <SolidColorBrush x:Key="PolygonTaskDownloadingBorderBrush" Color="{StaticResource PolygonTaskActivityDownloadingBorder}"/>
        <SolidColorBrush x:Key="PolygonTaskLaunchingBgBrush" Color="{StaticResource PolygonTaskActivityLaunchingBg}"/>
        <SolidColorBrush x:Key="PolygonTaskLaunchingBorderBrush" Color="{StaticResource PolygonTaskActivityLaunchingBorder}"/>

        <!-- ===== System Colors Override ===== -->
        <Color x:Key="SystemAccentColor">#39C5BB</Color>
        <Color x:Key="SystemAccentColorDark1">#2FB8A9</Color>
        <Color x:Key="SystemAccentColorDark2">#28A496</Color>
        <Color x:Key="SystemAccentColorLight1">#4DD4C9</Color>

        <!-- ===== Polygon Component Theme Colors ===== -->
        <Color x:Key="PolygonSurfaceColor">#F8FCFA</Color>
        <Color x:Key="PolygonSurfaceHoverColor">#E8F2ED</Color>
        <Color x:Key="PolygonBorderColor">#C8DDD2</Color>
        <Color x:Key="PolygonBorderHoverColor">#E94196</Color>
        <Color x:Key="PolygonProgressTrackColor">#D8E8E0</Color>
        <Color x:Key="PolygonComponentCardBg">#FFFFFF</Color>
        <Color x:Key="PolygonComponentCardBorder">#C8DDD2</Color>
        <Color x:Key="PolygonIconBoxBg">#DCF0E8</Color>
        <Color x:Key="PolygonDragGlyph">#4A6858</Color>
        <Color x:Key="PolygonEditorSurface">#F8FCFA</Color>
        <Color x:Key="PolygonEditorBorder">#B8D0C4</Color>
        <Color x:Key="PolygonCardBg">#F0F7F4</Color>
        <Color x:Key="PolygonCardBorder">#C8DDD2</Color>
        <Color x:Key="PolygonDeleteBg">#FDE8ED</Color>
        <Color x:Key="PolygonDeleteBorder">#E94196</Color>
        <Color x:Key="PolygonDeleteFg">#8B1A4A</Color>
        <Color x:Key="PolygonPresetBg">#F0F7F4</Color>
        <Color x:Key="PolygonPresetBorder">#B8D0C4</Color>
        <Color x:Key="PolygonLaunchSurface">#E94196</Color>
        <Color x:Key="PolygonLaunchSurfaceHover">#F05AA8</Color>
        <Color x:Key="PolygonLaunchBorder">#F470B8</Color>
        <Color x:Key="PolygonLaunchBorderHover">#F890C8</Color>
        <Color x:Key="PolygonLaunchProgressTrack">#C03078</Color>
        <Color x:Key="PolygonLaunchAccentFg">#FFFFFF</Color>
        <Color x:Key="PolygonSkinButtonBg">#F0F7F4</Color>
        <Color x:Key="PolygonSkinButtonBgCurrent">#E8F2ED</Color>
        <Color x:Key="PolygonSkinButtonBorder">#C8DDD2</Color>
        <Color x:Key="PolygonSkinButtonBorderCurrent">#E94196</Color>
        <Color x:Key="PolygonSkinAvatarBg">#E2EDE8</Color>
        <Color x:Key="PolygonTaskActivityDownloadingBg">#2E8B57</Color>
        <Color x:Key="PolygonTaskActivityDownloadingBorder">#4CAF50</Color>
        <Color x:Key="PolygonTaskActivityLaunchingBg">#E94196</Color>
        <Color x:Key="PolygonTaskActivityLaunchingBorder">#F05AA8</Color>
        <Color x:Key="PolygonDisabledText">#A0B4A8</Color>
        <Color x:Key="PolygonDragPreviewBg">#40E94196</Color>
    </Styles.Resources>

    <!-- Base Style for all controls -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}"/>
    </Style>

    <!-- Button Styles (Teal title bar, Pink accent) -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource MikuTealBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MikuTealBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="#2FB8A9"/>
        <Setter Property="BorderBrush" Value="#2FB8A9"/>
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <!-- TextBox Style -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource ControlBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MediumBorderBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{StaticResource MikuTealBrush}"/>
    </Style>

    <!-- CheckBox Style -->
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}"/>
    </Style>

    <!-- RadioButton Style -->
    <Style Selector="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}"/>
    </Style>

    <!-- Window Style -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource WindowBgBrush}"/>
    </Style>

    <!-- Card-like panel -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource PanelBgBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="8"/>
    </Style>

    <!-- Accent Button Variant (Miku Pink!) -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{StaticResource MikuPinkBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MikuPinkBrush}"/>
    </Style>

    <Style Selector="Button.accent:pointerover">
        <Setter Property="Background" Value="#F05AA8"/>
        <Setter Property="BorderBrush" Value="#F05AA8"/>
    </Style>

    <Style Selector="Button.accent:pressed">
        <Setter Property="Background" Value="#D63A87"/>
        <Setter Property="BorderBrush" Value="#D63A87"/>
    </Style>
</Styles>
