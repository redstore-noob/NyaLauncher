<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NyaLauncher.Avalonia.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <Color x:Key="SystemAccentColor">#7C8CFF</Color>
    <Color x:Key="SystemAccentColorDark1">#6C7BFF</Color>
    <Color x:Key="SystemAccentColorDark2">#5868EA</Color>
    <Color x:Key="SystemAccentColorLight1">#98A3FF</Color>
    <FontFamily x:Key="ContentFontTheme">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource ContentFontTheme}" />
    </Style>

    <Style Selector="Button:pointerover">
      <Setter Property="Opacity" Value="0.9" />
    </Style>

    <Style Selector="Button:pressed">
      <Setter Property="Opacity" Value="0.78" />
    </Style>

    <Style Selector="ScrollViewer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Application.Styles>
</Application>
