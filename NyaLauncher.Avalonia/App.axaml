<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NyaLauncher.Avalonia.App"
             >

  <Application.Resources>
    <FontFamily x:Key="ContentFontTheme">avares://NyaLauncher.Avalonia/Resources/Fonts#HarmonyOS Sans, avares://NyaLauncher.Avalonia/Resources/Fonts#Noto Color Emoji</FontFamily>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource ContentFontTheme}" />
    </Style>

    <Style Selector="Button:pointerover">
      <Setter Property="Opacity" Value="0.9" />
    </Style>

    <Style Selector="Button:pressed">
      <Setter Property="Opacity" Value="0.78" />
    </Style>

    <Style Selector="ScrollViewer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Application.Styles>
</Application>
