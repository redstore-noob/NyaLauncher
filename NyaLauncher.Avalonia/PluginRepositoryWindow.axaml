<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NyaLauncher.Avalonia.PluginRepositoryWindow"
        x:CompileBindings="False"
        Title="NyaLauncher 在线插件仓库"
        Width="1040"
        Height="720"
        MinWidth="860"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}">
  <Window.Styles>
    <Style Selector="Border.RepositoryRow">
      <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DefaultBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="11" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.RepositoryRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource HighlightBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.RepositoryRow">
      <Setter Property="Background" Value="{DynamicResource HighlightBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.DetailCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DefaultBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.StatusBadge">
      <Setter Property="Background" Value="{DynamicResource BadgeBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DefaultBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="7,3" />
    </Style>
    <Style Selector="Button.Primary">
      <Setter Property="Background" Value="{DynamicResource ComponentPrimaryBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ComponentPrimaryBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}" />
      <Setter Property="Padding" Value="18,9" />
    </Style>
    <Style Selector="Button.Primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource ComponentPrimaryHoverBgBrush}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,20">
    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,14">
      <StackPanel Spacing="3">
        <TextBlock Text="在线插件仓库"
                   FontSize="23"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}" />
        <TextBlock Text="浏览 NyaLauncher-Plugins 收录的第三方插件与每个具体版本"
                   FontSize="11"
                   Foreground="{DynamicResource MutedTextBrush}" />
      </StackPanel>
      <Button Grid.Column="1"
              Content="打开 GitHub 仓库"
              Margin="12,0,0,0"
              Padding="14,8"
              Click="OnOpenRepositoryClick" />
      <Button x:Name="RefreshRepositoryButton"
              Grid.Column="2"
              Content="刷新索引"
              Margin="8,0,0,0"
              Padding="14,8"
              Click="OnRefreshRepositoryClick" />
    </Grid>

    <Border Grid.Row="1"
            Background="{DynamicResource DialogAltBgBrush}"
            BorderBrush="{DynamicResource WarningBrush}"
            BorderThickness="1"
            CornerRadius="9"
            Padding="12,9"
            Margin="0,0,0,13">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
        <TextBlock Text="!"
                   FontWeight="Bold"
                   Foreground="{DynamicResource WarningBrush}" />
        <TextBlock Grid.Column="1"
                   Text="收录和版本审核均不等同于安全保证。安装前请核对来源与能力；下载时会校验固定大小与 SHA-256。"
                   FontSize="10"
                   Foreground="{DynamicResource WarningBrush}"
                   TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="330,16,*">
      <Border Background="{DynamicResource PanelBgBrush}"
              BorderBrush="{DynamicResource DefaultBorderBrush}"
              BorderThickness="1"
              CornerRadius="13"
              Padding="12">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
            <TextBox x:Name="RepositorySearchBox"
                     PlaceholderText="搜索名称、作者或 ID"
                     TextChanged="OnRepositorySearchChanged" />
            <Button x:Name="RepositoryClearSearchButton"
                    Grid.Column="1"
                    Content="清除"
                    IsVisible="False"
                    Padding="10,6"
                    Click="OnClearRepositorySearchClick" />
          </Grid>
          <ComboBox x:Name="RepositoryStateFilter"
                    Grid.Row="1"
                    Margin="0,9,0,0"
                    SelectedIndex="0"
                    SelectionChanged="OnRepositoryStateFilterChanged">
            <ComboBoxItem Content="全部插件" />
            <ComboBoxItem Content="可安装或有更新" />
            <ComboBoxItem Content="已安装" />
          </ComboBox>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="3,11,3,8">
            <TextBlock Text="插件"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BodyTextBrush}" />
            <TextBlock x:Name="RepositoryCountText"
                       Grid.Column="1"
                       Text="0"
                       FontSize="10"
                       Foreground="{DynamicResource HintTextBrush}" />
          </Grid>
          <Grid Grid.Row="3">
            <ListBox x:Name="RepositoryPluginList"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionChanged="OnRepositorySelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="RepositoryRow" Cursor="Hand">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <Border Width="40"
                              Height="40"
                              CornerRadius="11"
                              Background="{DynamicResource IconBoxBgBrush}">
                        <TextBlock Text="{Binding Initial}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Metadata}"
                                   FontSize="9"
                                   Foreground="{DynamicResource HintTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Background="{Binding StatusBackground}"
                                BorderBrush="{Binding StatusForeground}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="7,2"
                                HorizontalAlignment="Left">
                          <TextBlock Text="{Binding StatusText}"
                                     FontSize="8"
                                     FontWeight="SemiBold"
                                     Foreground="{Binding StatusForeground}" />
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyRepositoryView"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <TextBlock Text="◇"
                         FontSize="30"
                         Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Center" />
              <TextBlock x:Name="EmptyRepositoryTitle"
                         Text="准备读取仓库"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource BodyTextBrush}"
                         HorizontalAlignment="Center" />
              <TextBlock x:Name="EmptyRepositoryHint"
                         Text="索引来自 NyaLauncher-Plugins"
                         Width="240"
                         FontSize="10"
                         Foreground="{DynamicResource HintTextBrush}"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
              <Button x:Name="EmptyRepositoryActionButton"
                      Content="重试"
                      IsVisible="False"
                      HorizontalAlignment="Center"
                      Padding="14,7"
                      Click="OnEmptyRepositoryActionClick" />
            </StackPanel>

            <Border x:Name="RepositoryLoadingOverlay"
                    IsVisible="False"
                    Background="{DynamicResource OverlayBgBrush}"
                    CornerRadius="10">
              <StackPanel Spacing="10"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <ProgressBar Width="150" IsIndeterminate="True" />
                <TextBlock x:Name="RepositoryLoadingText"
                           Text="正在读取远程索引…"
                           FontSize="11"
                           Foreground="{DynamicResource AccentTextBrush}" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Background="{DynamicResource CardBgBrush}"
              BorderBrush="{DynamicResource DefaultBorderBrush}"
              BorderThickness="1"
              CornerRadius="13"
              Padding="20">
        <Grid>
          <StackPanel x:Name="EmptyRepositoryDetails"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="8">
            <TextBlock Text="＋"
                       FontSize="36"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="请选择一个在线插件"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BodyTextBrush}" />
            <TextBlock Text="可查看历史版本、审核记录、兼容性与下载校验"
                       FontSize="10"
                       Foreground="{DynamicResource HintTextBrush}" />
          </StackPanel>

          <Grid x:Name="RepositoryDetails" IsVisible="False" RowDefinitions="Auto,*,Auto">
            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,16">
              <Border Width="50"
                      Height="50"
                      CornerRadius="14"
                      Background="{DynamicResource IconBoxBgBrush}">
                <TextBlock x:Name="RepositoryDetailsInitial"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="13,0" Spacing="3" VerticalAlignment="Center">
                <TextBlock x:Name="RepositoryDetailsName"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock x:Name="RepositoryDetailsSummary"
                           FontSize="10"
                           Foreground="{DynamicResource MutedTextBrush}" />
              </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="12" Margin="0,0,5,0">
                <TextBlock x:Name="RepositoryDetailsDescription"
                           Foreground="{DynamicResource BodyTextBrush}"
                           TextWrapping="Wrap" />

                <Border Classes="DetailCard">
                  <StackPanel Spacing="8">
                    <TextBlock Text="插件信息"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <Grid ColumnDefinitions="118,*">
                      <TextBlock Text="插件 ID" Foreground="{DynamicResource SubtextTextBrush}" />
                      <TextBlock x:Name="RepositoryDetailsId"
                                 Grid.Column="1"
                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                 TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnDefinitions="118,*">
                      <TextBlock Text="作者" Foreground="{DynamicResource SubtextTextBrush}" />
                      <TextBlock x:Name="RepositoryDetailsAuthors"
                                 Grid.Column="1"
                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                 TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnDefinitions="118,*">
                      <TextBlock Text="许可证 / 分类" Foreground="{DynamicResource SubtextTextBrush}" />
                      <TextBlock x:Name="RepositoryDetailsLicense"
                                 Grid.Column="1"
                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                 TextWrapping="Wrap" />
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Classes="DetailCard">
                  <StackPanel Spacing="9">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="版本信息"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock x:Name="RepositoryDetailsVersionTitle"
                                   FontSize="10"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                      </StackPanel>
                      <Border x:Name="RepositoryDetailsAvailabilityBadge"
                              Grid.Column="1"
                              Classes="StatusBadge"
                              VerticalAlignment="Center">
                        <TextBlock x:Name="RepositoryDetailsAvailabilityText"
                                   FontSize="9"
                                   FontWeight="SemiBold" />
                      </Border>
                    </Grid>
                    <ComboBox x:Name="RepositoryVersionComboBox"
                              MinWidth="300"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnRepositoryVersionSelectionChanged">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="*,Auto"
                                ColumnSpacing="12"
                                MinWidth="360"
                                ToolTip.Tip="{Binding Hint}">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding VersionLabel}"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource PrimaryTextBrush}" />
                              <TextBlock Text="{Binding PublishedLabel}"
                                         FontSize="9"
                                         Foreground="{DynamicResource HintTextBrush}" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1"
                                       Orientation="Horizontal"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center">
                              <Border Classes="StatusBadge" Margin="0,0,5,0">
                                <TextBlock Text="{Binding ChannelName}"
                                           FontSize="8"
                                           Foreground="{Binding ChannelForeground}" />
                              </Border>
                              <Border Classes="StatusBadge" Margin="0,0,5,0">
                                <TextBlock Text="{Binding ReviewLabel}"
                                           FontSize="8"
                                           Foreground="{Binding ReviewForeground}" />
                              </Border>
                              <Border Classes="StatusBadge"
                                      Margin="0,0,5,0"
                                      IsVisible="{Binding IsInstalled}">
                                <TextBlock Text="已安装"
                                           FontSize="8"
                                           Foreground="{DynamicResource SuccessBrush}" />
                              </Border>
                              <Border Classes="StatusBadge"
                                      IsVisible="{Binding HasAvailabilityWarning}">
                                <TextBlock Text="{Binding AvailabilityLabel}"
                                           FontSize="8"
                                           Foreground="{DynamicResource ErrorBrush}" />
                              </Border>
                            </WrapPanel>
                          </Grid>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <WrapPanel Orientation="Horizontal">
                      <Border Classes="StatusBadge" Margin="0,0,6,0">
                        <TextBlock x:Name="RepositoryDetailsChannelText"
                                   FontSize="9"
                                   FontWeight="SemiBold" />
                      </Border>
                      <Border x:Name="RepositoryDetailsReviewBadge"
                              Classes="StatusBadge">
                        <TextBlock x:Name="RepositoryDetailsReviewBadgeText"
                                   FontSize="9"
                                   FontWeight="SemiBold" />
                      </Border>
                    </WrapPanel>
                    <TextBlock x:Name="RepositoryDetailsVersionHint"
                               FontSize="9"
                               Foreground="{DynamicResource HintTextBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border x:Name="RepositoryReviewCard" Classes="DetailCard">
                  <StackPanel Spacing="8">
                    <TextBlock Text="审核与完整性"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock x:Name="RepositoryDetailsReviewTitle"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="RepositoryDetailsReview"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                    <Border Height="1" Background="{DynamicResource SubtleBorderBrush}" />
                    <Grid ColumnDefinitions="118,*">
                      <TextBlock Text="下载校验" Foreground="{DynamicResource SubtextTextBrush}" />
                      <TextBlock x:Name="RepositoryDetailsHash"
                                 Grid.Column="1"
                                 FontFamily="Consolas"
                                 FontSize="10"
                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                 TextWrapping="Wrap" />
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Classes="DetailCard">
                  <Grid ColumnDefinitions="118,*">
                    <TextBlock Text="所需能力" Foreground="{DynamicResource SubtextTextBrush}" />
                    <TextBlock x:Name="RepositoryDetailsCapabilities"
                               Grid.Column="1"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                  </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="插件源仓库" Padding="12,6" Click="OnOpenPluginSourceClick" />
                  <Button x:Name="OpenReleaseNotesButton"
                          Content="发行说明"
                          Padding="12,6"
                          Click="OnOpenReleaseNotesClick" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="1,1,1,0"
                    CornerRadius="10,10,0,0"
                    Padding="13,11"
                    Margin="0,16,0,0">
              <Grid RowDefinitions="Auto,Auto,Auto">
                <TextBlock x:Name="InstallSelectionText"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <ProgressBar x:Name="InstallProgressBar"
                             Grid.Row="1"
                             IsVisible="False"
                             Minimum="0"
                             Maximum="1"
                             Height="5"
                             Margin="0,9,0,0" />
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,9,0,0">
                  <TextBlock x:Name="InstallHintText"
                             FontSize="10"
                             Foreground="{DynamicResource HintTextBrush}"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                  <Button x:Name="CancelInstallButton"
                          Grid.Column="1"
                          Content="取消"
                          IsVisible="False"
                          Margin="8,0,0,0"
                          Padding="14,8"
                          Click="OnCancelInstallClick" />
                  <Button x:Name="InstallPluginButton"
                          Grid.Column="2"
                          Classes="Primary"
                          Content="安装"
                          Margin="8,0,0,0"
                          Click="OnInstallPluginClick" />
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3"
            Background="{DynamicResource SurfaceBgBrush}"
            BorderBrush="{DynamicResource SubtleBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,7"
            Margin="0,12,0,0">
      <TextBlock x:Name="RepositoryStatusText"
                 Text="准备读取在线插件仓库"
                 FontSize="10"
                 Foreground="{DynamicResource MutedTextBrush}"
                 TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
