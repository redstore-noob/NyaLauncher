<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NyaLauncher.Avalonia.ConfigurationConflictDialog"
        Title="配置目录已存在"
        Width="540"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        Background="#111522"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,Auto" Margin="26">
    <StackPanel Grid.Row="0" Spacing="10">
      <TextBlock Text="目标目录已存在配置"
                 FontSize="21"
                 FontWeight="Bold"
                 Foreground="#F6F7FF" />
      <TextBlock Text="将直接应用目标目录中的配置，不会用当前配置覆盖它。是否删除旧目录中的配置文件？"
                 FontSize="13"
                 Foreground="#B7BED3"
                 TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="1"
            Margin="0,18,0,20"
            Padding="14"
            Background="#1B2132"
            BorderBrush="#30384F"
            BorderThickness="1"
            CornerRadius="10">
      <StackPanel Spacing="8">
        <TextBlock Text="旧配置目录"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="#8F98B3" />
        <TextBlock x:Name="PreviousDirectoryText"
                   FontFamily="Consolas"
                   FontSize="11"
                   Foreground="#E3E6F3"
                   TextWrapping="Wrap" />
        <TextBlock Text="将应用的目标目录"
                   Margin="0,6,0,0"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="#8F98B3" />
        <TextBlock x:Name="TargetDirectoryText"
                   FontFamily="Consolas"
                   FontSize="11"
                   Foreground="#E3E6F3"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="ExistingFilesText"
                   Margin="0,6,0,0"
                   FontSize="11"
                   Foreground="#AEB6FF"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="10">
      <Button Content="取消"
              Padding="16,8"
              Click="OnCancelClick" />
      <Button Content="否，备份旧配置"
              Padding="16,8"
              ToolTip.Tip="将旧配置移动到目标目录的 backup 文件夹"
              Click="OnBackupClick" />
      <Button Content="是，删除旧配置"
              Padding="16,8"
              Background="#B64A5A"
              Foreground="White"
              Click="OnDeleteClick" />
    </StackPanel>
  </Grid>
</Window>
