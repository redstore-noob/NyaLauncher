<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NyaLauncher.Avalonia\NyaLauncher.Avalonia.csproj" />
  </ItemGroup>

  <!-- Keep the dependency-free smoke runner compatible with the conventional
       `dotnet test` entry point instead of silently reporting zero tests. -->
  <Target Name="RunSmokeTestsAfterVSTest" AfterTargets="VSTest" DependsOnTargets="Build">
    <Exec Command="dotnet &quot;$(TargetPath)&quot;" />
  </Target>
</Project>
