{
  "manifestVersion": 1,
  "id": "io.github.touristh.clock",
  "name": "电子时钟示例",
  "version": "1.0.0",
  "apiVersion": "1.0",
  "minimumLauncherVersion": "0.1.0",
  "description": "显示当前电脑时间的电子钟组件，可切换 24/12 小时制并控制时区和秒的显示。",
  "authors": [
    "TouristH"
  ],
  "homepage": "https://github.com/redstore-noob/NyaLauncher/tree/testplug/examples/NyaLauncher.Clock",
  "license": "MIT",
  "entryAssembly": "NyaLauncher.Clock.dll",
  "entryType": "NyaLauncher.Clock.PluginEntry",
  "requiredCapabilities": [
    "ui.components",
    "system.info.read"
  ],
  "optionalCapabilities": [],
  "settings": [
    {
      "key": "time.format",
      "title": "时间制式",
      "description": "选择主要时分显示使用 24 小时制或 12 小时制。",
      "kind": "Choice",
      "scope": "Global",
      "defaultValue": "24",
      "required": true,
      "minimum": null,
      "maximum": null,
      "step": null,
      "maximumLength": null,
      "pattern": null,
      "placeholder": null,
      "options": [
        {
          "value": "24",
          "label": "24 小时制",
          "description": "以 00:00–23:59 显示。"
        },
        {
          "value": "12",
          "label": "12 小时制",
          "description": "以 01:00–12:59 显示，并在左下角显示 AM/PM。"
        }
      ],
      "fileExtensions": []
    },
    {
      "key": "display.timezone",
      "title": "显示时区",
      "description": "在组件顶端的小区域显示本地时区和当前 UTC 偏移。",
      "kind": "Boolean",
      "scope": "Global",
      "defaultValue": true,
      "required": true,
      "minimum": null,
      "maximum": null,
      "step": null,
      "maximumLength": null,
      "pattern": null,
      "placeholder": null,
      "options": [],
      "fileExtensions": []
    },
    {
      "key": "display.seconds",
      "title": "显示秒",
      "description": "在组件右下角的小区域显示秒。",
      "kind": "Boolean",
      "scope": "Global",
      "defaultValue": true,
      "required": true,
      "minimum": null,
      "maximum": null,
      "step": null,
      "maximumLength": null,
      "pattern": null,
      "placeholder": null,
      "options": [],
      "fileExtensions": []
    }
  ]
}
